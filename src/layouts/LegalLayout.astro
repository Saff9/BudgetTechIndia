---
/**
 * LegalLayout for BudgetTechIndia
 * Simple centered layout for legal pages (Privacy, Terms, etc.)
 */

import type { BreadcrumbItem } from '../utils/interfaces';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { formatDate } from '../utils/helpers';

interface Props {
  /** Page title */
  title: string;
  /** Page description for SEO */
  description: string;
  /** Last updated date */
  lastUpdated: Date | string;
  /** Breadcrumb items */
  breadcrumbs?: BreadcrumbItem[];
  /** Current page path */
  currentPath: string;
}

const {
  title,
  description,
  lastUpdated,
  breadcrumbs,
  currentPath,
} = Astro.props;

// Default breadcrumbs
const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: title },
];

const items = breadcrumbs || defaultBreadcrumbs;
---

<BaseLayout
  title={title}
  description={description}
  type="website"
  currentPath={currentPath}
>
  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={items} />

    <!-- Legal Content -->
    <article class="max-w-3xl mx-auto">
      <!-- Header -->
      <header class="mb-8 pb-8 border-b border-neutral-200">
        <h1 class="font-heading text-h1 text-neutral-900 mb-4">
          {title}
        </h1>
        <p class="text-sm text-neutral-500">
          Last updated: {formatDate(lastUpdated)}
        </p>
      </header>

      <!-- Content -->
      <div class="prose max-w-none">
        <slot />
      </div>

      <!-- Footer -->
      <footer class="mt-12 pt-8 border-t border-neutral-200">
        <p class="text-sm text-neutral-500">
          If you have any questions about this policy, please contact us at{' '}
          <a href="mailto:contact@budgettechindia.com" class="text-primary-600 hover:text-primary-700">
            contact@budgettechindia.com
          </a>
          .
        </p>
      </footer>
    </article>
  </div>
</BaseLayout>
