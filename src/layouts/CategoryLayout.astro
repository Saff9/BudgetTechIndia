---
/**
 * CategoryLayout for BudgetTechIndia
 * Layout for category pages with header, filters, and product grid
 */

import type { Category, Product, BreadcrumbItem } from '../utils/interfaces';
import type { SortType } from '../utils/productRanking';
import { sortProducts, SORT_OPTIONS } from '../utils/productRanking';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import AffiliateDisclosure from '../components/common/AffiliateDisclosure.astro';
import ProductCard from '../components/products/ProductCard.astro';

interface Props {
  /** Category data */
  category: Category;
  /** Products in this category */
  products: Product[];
  /** Breadcrumb items */
  breadcrumbs?: BreadcrumbItem[];
  /** Current sort option */
  currentSort?: SortType;
  /** Available sort options */
  sortOptions?: Array<{ value: string; label: string }>;
}

const {
  category,
  products: initialProducts,
  breadcrumbs,
  currentSort = 'newest',
  sortOptions = SORT_OPTIONS,
} = Astro.props;

// Sort products
const products = sortProducts(initialProducts, currentSort);

// Default breadcrumbs
const defaultBreadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Categories', url: '/categories' },
  { name: category.name },
];

const items = breadcrumbs || defaultBreadcrumbs;
---

<BaseLayout
  title={`${category.name} - Best Budget ${category.name} Under ₹2,000`}
  description={category.description}
  image={category.imageUrl}
  type="website"
  currentPath={`/categories/${category.slug}`}
>
  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={items} />

    <!-- Category Header -->
    <header class="mb-8">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="font-heading text-h1 text-neutral-900 mb-2">
            {category.name}
          </h1>
          <p class="text-neutral-600 max-w-2xl">
            {category.description}
          </p>
        </div>
        <div class="flex items-center gap-4 text-sm text-neutral-500">
          <span>{products.length} products</span>
          <span>•</span>
          <span>
            Price range: ₹{category.priceRange.min.toLocaleString('en-IN')} - ₹{category.priceRange.max.toLocaleString('en-IN')}
          </span>
        </div>
      </div>
    </header>

    <!-- Affiliate Disclosure -->
    <div class="mb-6">
      <AffiliateDisclosure variant="compact" />
    </div>

    <!-- Filter/Sort Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 p-4 bg-neutral-50 rounded-xl">
      <div class="flex items-center gap-2">
        <span class="text-sm text-neutral-500">Sort by:</span>
        <select
          id="sort-select"
          name="sort"
          class="form-select text-sm border-neutral-300 rounded-lg focus:ring-primary-500 focus:border-primary-500"
          aria-label="Sort products"
          data-current-sort={currentSort}
        >
          {sortOptions.map((option) => (
            <option value={option.value} selected={option.value === currentSort}>
              {option.label}
            </option>
          ))}
        </select>
      </div>

      <!-- Filter placeholders -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 transition-colors duration-200"
          aria-label="Filter products"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          Filters
        </button>
      </div>
    </div>

    <!-- Product Grid -->
    {products.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
        <h2 class="font-heading text-h4 text-neutral-700 mb-2">No products found</h2>
        <p class="text-neutral-500">Check back soon for new products in this category.</p>
      </div>
    )}

    <!-- Pagination placeholder -->
    {products.length > 12 && (
      <nav class="mt-12 flex justify-center" aria-label="Pagination">
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-500 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Previous
          </button>
          <span class="px-4 py-2 text-sm font-medium text-white bg-primary-500 rounded-lg">
            1
          </span>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            2
          </button>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            Next
          </button>
        </div>
      </nav>
    )}
  </div>

  <script>
    // Client-side sorting
    document.getElementById('sort-select')?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      const newSortType = select.value;
      
      // Get current URL params
      const urlParams = new URLSearchParams(window.location.search);
      urlParams.set('sort', newSortType);
      
      // Update URL without page reload
      window.history.replaceState({}, '', `${window.location.pathname}?${urlParams}`);
      
      // Reload the page to apply new sort
      window.location.reload();
    });
  </script>
</BaseLayout>
