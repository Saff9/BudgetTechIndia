---
/**
 * BaseLayout for BudgetTechIndia
 * Main layout with header, footer, and SEO components
 * Supports theme switching between dark and light variations
 */

import type { SEOMeta } from '../utils/interfaces';
import SEO from '../components/seo/SEO.astro';
import JsonLD from '../components/seo/JsonLD.astro';
import { getActiveVariation } from '../utils/variation';
import DarkHeader from '../components/common/Header.astro';
import LightHeader from '../components/light/Header.astro';
import DarkFooter from '../components/common/Footer.astro';
import LightFooter from '../components/light/Footer.astro';
import CookieConsent from '../components/common/CookieConsent.astro';
import BackToTop from '../components/common/BackToTop.astro';
import '../styles/global.css';
import '../styles/light.css';

interface Props extends SEOMeta {
  /** Current page path */
  currentPath?: string;
  /** Optional variation override */
  variation?: 'dark' | 'light';
}

const {
  currentPath = '/',
  variation: propVariation,
  title,
  description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  nofollow = false,
  ...seoProps
} = Astro.props;

const activeVariation = propVariation || getActiveVariation();
const isDarkTheme = activeVariation === 'dark';

// Import theme-specific components
const Header = isDarkTheme ? DarkHeader : LightHeader;
const Footer = isDarkTheme ? DarkFooter : LightFooter;

const siteUrl = import.meta.env.SITE_URL || 'https://budgettechindia.com';
const siteName = 'BudgetTechIndia';
const siteDescription = 'Your trusted source for honest tech product reviews under ₹2,000 in India. Find the best budget smartphones, earbuds, smartwatches, and more.';

// Organization schema
const organizationSchema = {
  name: siteName,
  url: siteUrl,
  logo: `${siteUrl}/images/logo.png`,
  description: siteDescription,
};

// Website schema
const websiteSchema = {
  name: siteName,
  url: siteUrl,
  description: siteDescription,
};
---

<!DOCTYPE html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Preconnect to external resources for faster font loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- Preload critical fonts for performance - Inter for clean, modern look -->
    <link 
      rel="preload" 
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin
    />
    <link 
      rel="preload" 
      href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuGKYAZ9hiJ-Ek-_EeA.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin
    />
    
    <!-- Google Fonts - Inter (Clean, modern, highly readable) -->
    <!-- Inter is used by both Shopify and many Amazon-style sites -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    
    <!-- Fallback system fonts stack -->
    <style>
      /* Font fallback styles for faster initial render */
      @font-face {
        font-family: 'Inter Fallback';
        src: local('Segoe UI'), local('Roboto'), local('Helvetica Neue'), local('Arial');
        size-adjust: 100%;
        ascent-override: 95%;
        descent-override: 25%;
        line-gap-override: 0%;
      }
    </style>
    
    <!-- SEO Meta Tags -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      nofollow={nofollow}
      url={currentPath}
    />
    
    <!-- JSON-LD Structured Data -->
    <JsonLD type="organization" data={organizationSchema} />
    <JsonLD type="website" data={websiteSchema} />
    
    <!-- Theme color for mobile browsers - Dynamic based on theme -->
    <meta name="theme-color" content={isDarkTheme ? "#0F1F24" : "#3B82F6"} />
    <meta name="msapplication-TileColor" content={isDarkTheme ? "#0F1F24" : "#3B82F6"} />
  </head>

  <body class={`flex flex-col min-h-screen antialiased ${isDarkTheme ? 'bg-[#0F1F24] text-[#F4F1EA]' : 'bg-white text-gray-900 light-theme'}`}
        data-theme={activeVariation}>
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class={`sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:transition-all ${
        isDarkTheme 
          ? 'focus:bg-[#C46A3A] focus:text-[#F4F1EA]' 
          : 'focus:bg-blue-500 focus:text-white'
      }`}
    >
      Skip to main content
    </a>

    <!-- Header - Theme specific -->
    <Header currentPath={currentPath} />

    <!-- Main Content - Theme specific background -->
    <main id="main-content" class={`flex-1 ${isDarkTheme ? 'bg-[#0F1F24]' : 'bg-white'}`}>
      <slot />
    </main>

    <!-- Footer - Theme specific -->
    <Footer />
    
    <!-- Cookie Consent Banner -->
    <CookieConsent />
    
    <!-- Back to Top Button -->
    <BackToTop />
  </body>
</html>
