---
/**
 * Hero Component for BudgetTechIndia Homepage
 * Premium Dark Theme - Midnight Teal gradient with Copper accents
 * Enhanced with animations, trust badges, and premium effects
 */

import CTAButton from '../content/CTAButton.astro';
import { siteConfig } from '../../utils/siteConfig';

interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
  showSearch?: boolean;
  showTrustBadges?: boolean;
}

const {
  title = "Best Budget Tech Products in India",
  subtitle = "Smart Choices, Smart Savings",
  description = "Discover honest reviews, detailed comparisons, and expert buying guides for budget-friendly tech products. Find the perfect gadgets under ₹500, ₹1000, ₹2000, and more.",
  showSearch = true,
  showTrustBadges = true,
} = Astro.props;

// Trust badges data
const trustBadges = [
  {
    icon: 'shield-check',
    title: 'Verified Reviews',
    description: '100+ Tested Products'
  },
  {
    icon: 'clock',
    title: 'Updated Weekly',
    description: 'Fresh Content'
  },
  {
    icon: 'currency-rupee',
    title: 'Best Prices',
    description: 'Budget Focused'
  },
  {
    icon: 'star',
    title: 'Expert Picks',
    description: 'Curated Selection'
  }
];
---

<section class="hero relative overflow-hidden py-14 md:py-20 lg:py-28">
  <!-- Animated background gradient -->
  <div class="absolute inset-0 bg-gradient-hero" aria-hidden="true"></div>
  
  <!-- Animated mesh pattern -->
  <div class="absolute inset-0 bg-mesh-gradient opacity-40" aria-hidden="true"></div>
  
  <!-- Floating decorative elements -->
  <div class="absolute top-20 right-10 w-96 h-96 bg-[#FFB800]/15 rounded-full blur-3xl animate-float" aria-hidden="true"></div>
  <div class="absolute bottom-20 left-10 w-[450px] h-[450px] bg-[#00F5A0]/10 rounded-full blur-3xl animate-float-slow" aria-hidden="true"></div>
  <div class="absolute top-1/2 left-1/4 w-64 h-64 bg-[#8B5CF6]/15 rounded-full blur-3xl animate-float" style="animation-delay: 1s;" aria-hidden="true"></div>
  
  <!-- Decorative grid pattern -->
  <div class="absolute inset-0 decorative-grid opacity-20" aria-hidden="true"></div>
  
  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Animated badge -->
      <div class="inline-flex items-center gap-2 bg-[#0B0F19]/80 backdrop-blur-xl border border-white/10 rounded-full px-5 py-2.5 mb-8 animate-fade-in-down shadow-glow-copper">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FFB800] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#FFB800] shadow-glow-copper"></span>
        </span>
        <span class="text-xs font-mono font-bold tracking-wider text-[#F8FAFC] uppercase">ENGINEERING BENCHMARKS • TAG: <span class="text-[#FFB800]">budgettechpro-21</span></span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#FFB800]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </div>
      
      <!-- Main Headline with gradient text option -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-extrabold mb-6 leading-tight tracking-tight animate-fade-in-up">
        <span class="gradient-text-gold">{title}</span>
      </h1>
      
      <!-- Animated subtitle -->
      <p class="text-xl md:text-2xl mb-6 font-bold text-[#00F5A0] animate-fade-in-up stagger-1">
        {subtitle}
      </p>
      
      <!-- Description -->
      <p class="text-base md:text-lg text-[#CBD5E1] mb-10 max-w-2xl mx-auto leading-relaxed animate-fade-in-up stagger-2">
        {description}
      </p>
      
      <!-- CTA Buttons with premium effects -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12 animate-fade-in-up stagger-3">
        <CTAButton 
          href="/reviews/" 
          text="Browse Reviews" 
          variant="primary"
          size="lg"
        />
        <CTAButton 
          href="/categories/" 
          text="Explore Categories" 
          variant="secondary"
          size="lg"
        />
      </div>
      
      <!-- Enhanced Search Bar -->
      {showSearch && (
        <div class="max-w-2xl mx-auto animate-fade-in-up stagger-4 mb-12">
          <form action="/search" method="GET" class="relative flex shadow-2xl rounded-2xl overflow-hidden border border-white/10 bg-[#0B0F19]/90 backdrop-blur-xl hover:border-[#FFB800]/40 transition-all duration-300">
            <select 
              name="category" 
              class="hidden md:block px-5 py-4 text-sm bg-transparent text-[#F8FAFC] border-r border-white/10 focus:outline-none focus:bg-[#111827] transition-colors cursor-pointer"
            >
              <option value="">All Categories</option>
              <option value="earbuds">Earbuds</option>
              <option value="smartwatch">Smartwatches</option>
              <option value="powerbank">Power Banks</option>
              <option value="accessories">Accessories</option>
            </select>
            <input
              type="text"
              name="q"
              placeholder="Search for products, reviews, guides..."
              class="flex-1 px-5 py-4 text-sm text-[#F8FAFC] bg-transparent focus:outline-none transition-all duration-200 placeholder:text-[#64748B]"
            />
            <button
              type="submit"
              class="px-6 py-4 bg-gradient-to-r from-[#FFE500] via-[#FFB800] to-[#FF7A00] text-[#06080F] font-bold transition-all duration-300 flex items-center justify-center gap-2 group shadow-cta hover:opacity-95"
              aria-label="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:scale-125 group-hover:rotate-12 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <span class="hidden sm:inline font-bold">Search</span>
            </button>
          </form>
          
          <!-- Quick search suggestions -->
          <div class="flex flex-wrap justify-center gap-2 mt-4">
            <span class="text-xs text-[#64748B]">Popular:</span>
            <a href="/reviews/best-earbuds-under-1000" class="text-xs text-[#CBD5E1] hover:text-[#FFB800] transition-colors">Earbuds under ₹1000</a>
            <span class="text-white/20">•</span>
            <a href="/reviews/best-smartwatch-under-2000" class="text-xs text-[#CBD5E1] hover:text-[#FFB800] transition-colors">Smartwatches</a>
            <span class="text-white/20">•</span>
            <a href="/top-5/best-power-banks-under-1500" class="text-xs text-[#CBD5E1] hover:text-[#FFB800] transition-colors">Power Banks</a>
          </div>
        </div>
      )}
      
      <!-- Trust Badges Section -->
      {showTrustBadges && (
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto animate-fade-in-up stagger-5">
          {trustBadges.map((badge, index) => (
            <div class="p-4 bg-[#0B0F19]/70 backdrop-blur-md border border-white/10 rounded-2xl cursor-pointer hover:-translate-y-1 hover:border-[#FFB800]/40 transition-all duration-300 flex flex-col items-center justify-center gap-2 shadow-card" style={`animation-delay: ${index * 100}ms`}>
              <div class="w-10 h-10 rounded-xl bg-[#FFB800]/10 flex items-center justify-center text-[#FFB800] group-hover:scale-110 transition-all duration-300">
                {badge.icon === 'shield-check' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
                {badge.icon === 'clock' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                )}
                {badge.icon === 'currency-rupee' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 8h6m-5 4h4m-3 4l3-4m-3 4v-4m0-4V8m0 0l3 4" />
                  </svg>
                )}
                {badge.icon === 'star' && (
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  </svg>
                )}
              </div>
              <span class="text-sm font-bold text-[#F8FAFC]">{badge.title}</span>
              <span class="text-xs text-[#CBD5E1]">{badge.description}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
  
  <!-- Bottom wave decoration -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#FFB800]/40 to-transparent" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, #06080F 0%, #0B0F19 50%, #06080F 100%);
  }
  
  /* Enhanced animations */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) scale(1);
    }
    50% {
      transform: translateY(-20px) scale(1.05);
    }
  }
  
  @keyframes float-slow {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-30px) rotate(3deg);
    }
  }
</style>
