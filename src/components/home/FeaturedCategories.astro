---
/**
 * FeaturedCategories Component for BudgetTechIndia Homepage
 * Premium Dark Theme - Slate cards with Copper accents
 */

import { siteConfig } from '../../utils/siteConfig';

interface Category {
  name: string;
  slug: string;
  description: string;
  icon: string;
  image?: string;
  count?: number;
}

interface Props {
  title?: string;
  subtitle?: string;
  categories?: Category[];
  columns?: 2 | 3 | 4;
}

// Default categories
const defaultCategories: Category[] = [
  {
    name: 'Earbuds',
    slug: 'earbuds',
    description: 'Best budget wireless earbuds',
    icon: 'headphones',
    image: '/images/categories/earbuds.jpg',
    count: 45,
  },
  {
    name: 'Smartwatches',
    slug: 'smartwatches',
    description: 'Affordable smartwatches',
    icon: 'watch',
    image: '/images/categories/smartwatches.jpg',
    count: 38,
  },
  {
    name: 'Power Banks',
    slug: 'power-banks',
    description: 'Reliable power banks',
    icon: 'battery',
    image: '/images/categories/power-banks.jpg',
    count: 25,
  },
  {
    name: 'Speakers',
    slug: 'speakers',
    description: 'Bluetooth speakers',
    icon: 'speaker',
    image: '/images/categories/speakers.jpg',
    count: 32,
  },
  {
    name: 'Headphones',
    slug: 'headphones',
    description: 'Wired & wireless headphones',
    icon: 'headphones-alt',
    image: '/images/categories/headphones.jpg',
    count: 28,
  },
  {
    name: 'Accessories',
    slug: 'accessories',
    description: 'Tech accessories',
    icon: 'cable',
    image: '/images/categories/accessories.jpg',
    count: 56,
  },
];

const {
  title = "Browse by Category",
  subtitle = "Find the perfect tech products in your favorite category",
  categories = defaultCategories,
  columns = 3,
} = Astro.props;

// Icon mapping
const icons: Record<string, string> = {
  headphones: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
  watch: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  battery: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  speaker: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>`,
  'headphones-alt': `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>`,
  cable: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" /></svg>`,
};

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};
---

<section class="featured-categories py-12 md:py-16 bg-[#0F1F24]">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-[#F4F1EA] mb-3">
        {title}
      </h2>
      <p class="text-base text-[#a8b5ba] max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>
    
    <!-- Categories Grid -->
    <div class={`grid grid-cols-2 ${gridCols[columns]} gap-4 md:gap-6`}>
      {categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="group relative bg-[#1A2E35] rounded-lg p-5 shadow-card hover:shadow-card-hover transition-all duration-300 border border-[#2a4450] hover:border-[#C46A3A]/50 overflow-hidden"
        >
          <!-- Icon -->
          <div class="relative w-12 h-12 bg-[#C46A3A]/20 rounded-lg flex items-center justify-center text-[#C46A3A] mb-4 group-hover:bg-[#C46A3A] group-hover:text-[#F4F1EA] transition-colors duration-200">
            <Fragment set:html={icons[category.icon] || icons.headphones} />
          </div>
          
          <!-- Content -->
          <h3 class="text-base font-semibold text-[#F4F1EA] mb-1 group-hover:text-[#C46A3A] transition-colors duration-200">
            {category.name}
          </h3>
          <p class="text-sm text-[#a8b5ba] mb-2 line-clamp-1">
            {category.description}
          </p>
          
          <!-- Product Count -->
          {category.count && (
            <span class="text-xs text-[#6b7d83]">
              {category.count} products
            </span>
          )}
          
          <!-- Arrow indicator -->
          <div class="absolute bottom-4 right-4 w-8 h-8 bg-[#0F1F24] rounded-full flex items-center justify-center text-[#6b7d83] group-hover:bg-[#C46A3A] group-hover:text-[#F4F1EA] transition-all duration-200 transform translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
    
    <!-- View All Link -->
    <div class="text-center mt-8">
      <a
        href="/categories/"
        class="inline-flex items-center gap-2 text-[#C46A3A] hover:text-[#d4834f] font-medium transition-colors duration-200"
      >
        View All Categories
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
