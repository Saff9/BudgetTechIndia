---
/**
 * FeaturedCategories Component for BudgetTechIndia Homepage
 * Premium Dark Theme - Slate cards with Copper accents
 */

import { siteConfig } from '../../utils/siteConfig';

interface Category {
  name: string;
  slug: string;
  description: string;
  icon: string;
  image?: string;
  count?: number;
}

interface Props {
  title?: string;
  subtitle?: string;
  categories?: Category[];
  columns?: 2 | 3 | 4;
}

// Default categories
const defaultCategories: Category[] = [
  {
    name: 'Earbuds',
    slug: 'earbuds',
    description: 'Best budget wireless earbuds',
    icon: 'headphones',
    image: '/images/categories/earbuds.jpg',
    count: 45,
  },
  {
    name: 'Smartwatches',
    slug: 'smartwatches',
    description: 'Affordable smartwatches',
    icon: 'watch',
    image: '/images/categories/smartwatches.jpg',
    count: 38,
  },
  {
    name: 'Power Banks',
    slug: 'power-banks',
    description: 'Reliable power banks',
    icon: 'battery',
    image: '/images/categories/power-banks.jpg',
    count: 25,
  },
  {
    name: 'Speakers',
    slug: 'speakers',
    description: 'Bluetooth speakers',
    icon: 'speaker',
    image: '/images/categories/speakers.jpg',
    count: 32,
  },
  {
    name: 'Headphones',
    slug: 'headphones',
    description: 'Wired & wireless headphones',
    icon: 'headphones-alt',
    image: '/images/categories/headphones.jpg',
    count: 28,
  },
  {
    name: 'Accessories',
    slug: 'accessories',
    description: 'Tech accessories',
    icon: 'cable',
    image: '/images/categories/accessories.jpg',
    count: 56,
  },
];

const {
  title = "Browse by Category",
  subtitle = "Find the perfect tech products in your favorite category",
  categories = defaultCategories,
  columns = 3,
} = Astro.props;

// Icon mapping
const icons: Record<string, string> = {
  headphones: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
  watch: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  battery: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  speaker: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>`,
  'headphones-alt': `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>`,
  cable: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" /></svg>`,
};

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};
---

<section class="featured-categories py-14 md:py-20 bg-transparent relative">
  <div class="container mx-auto px-4 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-extrabold text-[#F8FAFC] mb-3 tracking-tight">
        <span class="gradient-text-gold">{title}</span>
      </h2>
      <p class="text-base text-[#CBD5E1] max-w-2xl mx-auto">
        {subtitle}
      </p>
    </div>
    
    <!-- Categories Grid -->
    <div class={`grid grid-cols-2 ${gridCols[columns]} gap-4 md:gap-6`}>
      {categories.map((category) => (
        <a
          href={`/categories/${category.slug}/`}
          class="group relative bg-[#0B0F19]/80 backdrop-blur-xl rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-all duration-300 border border-white/10 hover:border-[#FFB800]/50 overflow-hidden transform hover:-translate-y-1.5"
        >
          <!-- Icon with Gold Glow -->
          <div class="relative w-14 h-14 bg-[#FFB800]/10 border border-[#FFB800]/20 rounded-2xl flex items-center justify-center text-[#FFB800] mb-5 group-hover:bg-[#FFB800] group-hover:text-[#06080F] group-hover:scale-110 transition-all duration-300 shadow-md">
            <Fragment set:html={icons[category.icon] || icons.headphones} />
          </div>
          
          <!-- Content -->
          <h3 class="text-lg font-bold text-[#F8FAFC] mb-1.5 group-hover:text-[#FFB800] transition-colors duration-200">
            {category.name}
          </h3>
          <p class="text-xs md:text-sm text-[#CBD5E1] mb-3 line-clamp-1">
            {category.description}
          </p>
          
          <!-- Product Count -->
          {category.count && (
            <span class="inline-block text-xs font-semibold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-[#00F5A0]">
              {category.count} products
            </span>
          )}
          
          <!-- Arrow indicator -->
          <div class="absolute bottom-5 right-5 w-9 h-9 bg-[#06080F] rounded-full border border-white/10 flex items-center justify-center text-[#CBD5E1] group-hover:bg-[#FFB800] group-hover:text-[#06080F] group-hover:border-[#FFB800] transition-all duration-300 transform translate-x-2 opacity-0 group-hover:translate-x-0 group-hover:opacity-100 shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
    
    <!-- View All Link -->
    <div class="text-center mt-10">
      <a
        href="/categories/"
        class="inline-flex items-center gap-2 text-[#FFB800] hover:text-[#FFE500] font-bold text-base transition-colors duration-200"
      >
        View All Categories
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
