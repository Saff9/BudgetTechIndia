---
/**
 * LatestReviews Component for BudgetTechIndia Homepage
 * Displays a grid of the latest product reviews
 */

import ArticleCard from '../content/ArticleCard.astro';
import CTAButton from '../content/CTAButton.astro';

interface Review {
  title: string;
  slug: string;
  excerpt: string;
  image: string;
  category: string;
  date: string;
  rating?: number;
  priceRange?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  reviews?: Review[];
  showViewAll?: boolean;
  columns?: 2 | 3 | 4;
}

// Default sample reviews
const defaultReviews: Review[] = [
  {
    title: 'Best Earbuds Under ₹1000 in India',
    slug: 'best-earbuds-under-1000',
    excerpt: 'Discover the top wireless earbuds under ₹1000 with amazing sound quality and battery life.',
    image: '/images/reviews/earbuds-under-1000.jpg',
    category: 'Earbuds',
    date: '2024-01-20',
    rating: 4.5,
    priceRange: 'Under ₹1000',
  },
  {
    title: 'Best Smartwatch Under ₹2000',
    slug: 'best-smartwatch-under-2000',
    excerpt: 'Complete guide to the best budget smartwatches with fitness tracking and smart features.',
    image: '/images/reviews/smartwatch-under-2000.jpg',
    category: 'Smartwatches',
    date: '2024-01-15',
    rating: 4.3,
    priceRange: 'Under ₹2000',
  },
  {
    title: 'Top 5 Power Banks Under ₹1500',
    slug: 'best-power-banks-under-1500',
    excerpt: 'Never run out of battery with these reliable and affordable power banks.',
    image: '/images/reviews/power-banks.jpg',
    category: 'Power Banks',
    date: '2024-01-10',
    rating: 4.4,
    priceRange: 'Under ₹1500',
  },
  {
    title: 'Top 5 Earbuds Under ₹500',
    slug: 'best-earbuds-under-500',
    excerpt: 'Amazing wireless earbuds at an unbeatable price point for budget buyers.',
    image: '/images/reviews/earbuds-under-500.jpg',
    category: 'Earbuds',
    date: '2024-01-08',
    rating: 4.0,
    priceRange: 'Under ₹500',
  },
  {
    title: 'Best Bluetooth Speakers Under ₹2000',
    slug: 'best-speakers-under-2000',
    excerpt: 'Portable speakers with great sound quality for parties and outdoor use.',
    image: '/images/reviews/speakers.jpg',
    category: 'Speakers',
    date: '2024-01-05',
    rating: 4.2,
    priceRange: 'Under ₹2000',
  },
  {
    title: 'Best Headphones Under ₹3000',
    slug: 'best-headphones-under-3000',
    excerpt: 'Over-ear headphones with excellent sound quality and comfort for long listening sessions.',
    image: '/images/reviews/headphones.jpg',
    category: 'Headphones',
    date: '2024-01-01',
    rating: 4.5,
    priceRange: 'Under ₹3000',
  },
];

const {
  title = "Latest Reviews",
  subtitle = "In-depth reviews to help you make the right choice",
  reviews = defaultReviews,
  showViewAll = true,
  columns = 3,
} = Astro.props;

const gridCols = {
  2: 'md:grid-cols-2',
  3: 'md:grid-cols-2 lg:grid-cols-3',
  4: 'md:grid-cols-2 lg:grid-cols-4',
};

// Format date
const formatDate = (dateStr: string): string => {
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
};
---

<section class="latest-reviews py-16 bg-white">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          {title}
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl">
          {subtitle}
        </p>
      </div>
      {showViewAll && (
        <a
          href="/reviews/"
          class="hidden md:inline-flex items-center gap-2 text-blue-600 hover:text-blue-700 font-medium transition-colors mt-4 md:mt-0"
        >
          View All Reviews
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      )}
    </div>
    
    <!-- Reviews Grid -->
    <div class={`grid grid-cols-1 ${gridCols[columns]} gap-6`}>
      {reviews.map((review, index) => (
        <article class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 hover:border-blue-200">
          <!-- Image -->
          <a href={`/reviews/${review.slug}/`} class="block relative overflow-hidden aspect-video">
            <img
              src={review.image}
              alt={review.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading={index < 3 ? 'eager' : 'lazy'}
            />
            <!-- Category Badge -->
            <span class="absolute top-4 left-4 bg-blue-600 text-white text-xs font-medium px-3 py-1 rounded-full">
              {review.category}
            </span>
            <!-- Price Range Badge -->
            {review.priceRange && (
              <span class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm text-gray-800 text-xs font-medium px-3 py-1 rounded-full">
                {review.priceRange}
              </span>
            )}
          </a>
          
          <!-- Content -->
          <div class="p-6">
            <!-- Rating -->
            {review.rating && (
              <div class="flex items-center gap-1 mb-3">
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class={`h-4 w-4 ${star <= Math.round(review.rating!) ? 'text-yellow-400' : 'text-gray-300'}`}
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                  </svg>
                ))}
                <span class="ml-2 text-sm text-gray-600">{review.rating.toFixed(1)}</span>
              </div>
            )}
            
            <!-- Title -->
            <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
              <a href={`/reviews/${review.slug}/`}>
                {review.title}
              </a>
            </h3>
            
            <!-- Excerpt -->
            <p class="text-gray-600 mb-4 line-clamp-2">
              {review.excerpt}
            </p>
            
            <!-- Meta -->
            <div class="flex items-center justify-between text-sm text-gray-500">
              <time datetime={review.date}>
                {formatDate(review.date)}
              </time>
              <a
                href={`/reviews/${review.slug}/`}
                class="text-blue-600 hover:text-blue-700 font-medium inline-flex items-center gap-1"
              >
                Read More
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
    
    <!-- Mobile View All -->
    {showViewAll && (
      <div class="md:hidden text-center mt-8">
        <CTAButton href="/reviews/" text="View All Reviews" variant="primary" />
      </div>
    )}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
