---
/**
 * PriceTag Component for BudgetTechIndia
 * Amazon-style price display with discount
 */

import { formatPrice, calculateDiscount } from '../../utils/helpers';

interface Props {
  /** Current selling price in INR */
  price: number;
  /** Original MRP in INR */
  mrp?: number;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Whether to show discount percentage */
  showDiscount?: boolean;
}

const {
  price,
  mrp,
  size = 'md',
  showDiscount = true,
} = Astro.props;

// Calculate discount
const discount = mrp && mrp > price ? calculateDiscount(price, mrp) : 0;
const hasDiscount = discount > 0;

// Size classes
const priceSizeClasses = {
  sm: 'text-base',
  md: 'text-lg',
  lg: 'text-xl',
};

const mrpSizeClasses = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};

const discountSizeClasses = {
  sm: 'text-xs',
  md: 'text-sm',
  lg: 'text-base',
};
---

<div class="inline-flex flex-wrap items-baseline gap-2">
  <!-- Current Price -->
  <span class={`font-bold text-text-primary ${priceSizeClasses[size]}`}>
    {formatPrice(price)}
  </span>
  
  <!-- MRP (if discounted) -->
  {hasDiscount && mrp && (
    <span class={`text-text-muted line-through ${mrpSizeClasses[size]}`}>
      {formatPrice(mrp)}
    </span>
  )}
  
  <!-- Discount Badge - Amazon style red -->
  {showDiscount && hasDiscount && (
    <span class={`inline-flex items-center px-2 py-0.5 rounded text-deal-red font-semibold ${discountSizeClasses[size]}`}>
      {discount}% off
    </span>
  )}
</div>
