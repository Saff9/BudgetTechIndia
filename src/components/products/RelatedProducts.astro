---
import type { Product } from '../../utils/interfaces';
import { getRelatedProducts } from '../../utils/suggestionAlgorithm';
import { getViewedProductIds, getClickedProductIds } from '../../utils/userBehavior';
import ProductCard from './ProductCard.astro';

interface Props {
  targetProduct: Product;
  allProducts: Product[];
  title?: string;
  limit?: number;
}

const { 
  targetProduct, 
  allProducts, 
  title = 'Related Products', 
  limit = 4 
} = Astro.props;

// Get user behavior data
const userBehavior = {
  viewed: getViewedProductIds(),
  clicked: getClickedProductIds()
};

// Get related products
const relatedProducts = getRelatedProducts(targetProduct, allProducts, userBehavior, limit);
---

{relatedProducts.length > 0 && (
  <section class="related-products-section mb-12">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{title}</h2>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {relatedProducts.map((product, index) => (
        <ProductCard product={product} key={product.id} position={index} />
      ))}
    </div>
  </section>
)}

<style>
  .related-products-section {
    animation: fadeInUp 0.6s ease-out;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
