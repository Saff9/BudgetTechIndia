---
/**
 * ComparisonTable Component for BudgetTechIndia
 * Responsive comparison table for multiple products
 */

import type { Product } from '../../utils/interfaces';
import { formatPrice } from '../../utils/helpers';
import RatingStars from './RatingStars.astro';

interface Props {
  /** Products to compare */
  products: Product[];
  /** Features to display in comparison */
  features?: string[];
  /** Whether to highlight best values */
  highlightBest?: boolean;
}

const { products, features = [], highlightBest = true } = Astro.props;

// Get all unique feature keys from products
const allFeatureKeys = new Set<string>();
products.forEach((product) => {
  Object.keys(product.features || {}).forEach((key) => allFeatureKeys.add(key));
});

// Use provided features or all features from products
const featureKeys = features.length > 0 ? features : Array.from(allFeatureKeys);

// Find best price and rating
const bestPrice = Math.min(...products.map((p) => p.price));
const bestRating = Math.max(...products.map((p) => p.rating));

// Check if a feature value is the best (simple heuristic: shortest string or highest number)
function isBestValue(value: string, allValues: string[]): boolean {
  const numericValues = allValues.map((v) => parseFloat(v)).filter((v) => !isNaN(v));
  if (numericValues.length === allValues.length) {
    return parseFloat(value) === Math.max(...numericValues);
  }
  return false;
}
---

{products.length === 0 ? (
  <p class="text-neutral-500 text-center py-8">No products to compare.</p>
) : (
  <div class="overflow-hidden">
    <!-- Desktop Table View -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full border-collapse bg-white rounded-xl overflow-hidden shadow-card">
        <thead>
          <tr class="bg-neutral-100">
            <th class="p-4 text-left font-semibold text-neutral-800 border-b border-neutral-200 w-40">
              Feature
            </th>
            {products.map((product) => (
              <th
                class={`p-4 text-center border-b border-neutral-200 ${
                  highlightBest && product.price === bestPrice ? 'bg-green-50' : ''
                }`}
              >
                <div class="flex flex-col items-center gap-2">
                  <img
                    src={product.imageUrl}
                    alt={product.name}
                    class="w-20 h-20 object-contain"
                    loading="lazy"
                  />
                  <span class="font-semibold text-neutral-900 text-sm line-clamp-2">
                    {product.name}
                  </span>
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          <!-- Price Row -->
          <tr class="hover:bg-neutral-50">
            <td class="p-4 font-medium text-neutral-700 border-b border-neutral-100">
              Price
            </td>
            {products.map((product) => (
              <td
                class={`p-4 text-center border-b border-neutral-100 ${
                  highlightBest && product.price === bestPrice ? 'bg-green-50 font-semibold text-green-700' : ''
                }`}
              >
                <span class="text-lg font-bold text-neutral-900">
                  {formatPrice(product.price)}
                </span>
                {highlightBest && product.price === bestPrice && (
                  <span class="block text-xs text-green-600 mt-1">Best Price</span>
                )}
              </td>
            ))}
          </tr>

          <!-- Rating Row -->
          <tr class="hover:bg-neutral-50">
            <td class="p-4 font-medium text-neutral-700 border-b border-neutral-100">
              Rating
            </td>
            {products.map((product) => (
              <td
                class={`p-4 text-center border-b border-neutral-100 ${
                  highlightBest && product.rating === bestRating ? 'bg-green-50' : ''
                }`}
              >
                <div class="flex flex-col items-center gap-1">
                  <RatingStars rating={product.rating} size="sm" showNumeric={true} showCount={false} />
                  {highlightBest && product.rating === bestRating && (
                    <span class="text-xs text-green-600">Top Rated</span>
                  )}
                </div>
              </td>
            ))}
          </tr>

          <!-- Feature Rows -->
          {featureKeys.map((key) => {
            const featureValues = products.map((p) => p.features?.[key] || '-');
            return (
              <tr class="hover:bg-neutral-50">
                <td class="p-4 font-medium text-neutral-700 border-b border-neutral-100 capitalize">
                  {key.replace(/([A-Z])/g, ' $1').replace(/-/g, ' ')}
                </td>
                {products.map((product, index) => {
                  const value = product.features?.[key] || '-';
                  const isBest = highlightBest && isBestValue(value, featureValues);
                  return (
                    <td
                      class={`p-4 text-center border-b border-neutral-100 ${
                        isBest ? 'bg-green-50 font-semibold' : ''
                      }`}
                    >
                      {value}
                    </td>
                  );
                })}
              </tr>
            );
          })}

          <!-- Buy Button Row -->
          <tr>
            <td class="p-4"></td>
            {products.map((product) => (
              <td class="p-4 text-center">
                <a
                  href={product.affiliateUrl}
                  target="_blank"
                  rel="nofollow sponsored"
                  class="btn-primary inline-flex text-sm px-4 py-2"
                >
                  Check Price
                </a>
              </td>
            ))}
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Mobile Card View -->
    <div class="md:hidden space-y-4">
      {products.map((product) => (
        <div class="bg-white rounded-xl shadow-card overflow-hidden">
          <!-- Product Header -->
          <div class="flex items-center gap-4 p-4 border-b border-neutral-100">
            <img
              src={product.imageUrl}
              alt={product.name}
              class="w-20 h-20 object-contain"
              loading="lazy"
            />
            <div class="flex-1">
              <h3 class="font-semibold text-neutral-900 mb-1">{product.name}</h3>
              <p class="text-lg font-bold text-neutral-900">{formatPrice(product.price)}</p>
              <RatingStars rating={product.rating} size="sm" />
            </div>
          </div>

          <!-- Features -->
          <div class="p-4 space-y-2">
            {featureKeys.map((key) => (
              <div class="flex justify-between text-sm">
                <span class="text-neutral-500 capitalize">
                  {key.replace(/([A-Z])/g, ' $1').replace(/-/g, ' ')}
                </span>
                <span class="font-medium text-neutral-700">
                  {product.features?.[key] || '-'}
                </span>
              </div>
            ))}
          </div>

          <!-- Buy Button -->
          <div class="p-4 border-t border-neutral-100">
            <a
              href={product.affiliateUrl}
              target="_blank"
              rel="nofollow sponsored"
              class="btn-primary w-full text-center"
            >
              Check Price on Amazon
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
