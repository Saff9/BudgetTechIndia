---
/**
 * ProductCard Component for BudgetTechIndia
 * Premium Dark Theme - Enhanced with hover effects, quick actions
 * Features: Image zoom, wishlist, quick view, stock status, savings display
 * Uses centralized affiliate management system
 */

import type { Product } from '../../utils/interfaces';
import { 
  getAffiliateLink, 
  getProductPrice, 
  isInStock,
  formatPrice,
  createTrackedLink,
  type StoreType 
} from '../../utils/affiliate';
import RatingStars from './RatingStars.astro';

interface Props {
  /** Product data */
  product: Product;
  /** Whether to show rating */
  showRating?: boolean;
  /** Whether to show price */
  showPrice?: boolean;
  /** Layout variant */
  layout?: 'grid' | 'list';
  /** Show rank badge */
  rank?: number;
  /** Show quick actions */
  showQuickActions?: boolean;
  /** Show stock status */
  showStockStatus?: boolean;
  /** Preferred store for affiliate links */
  preferredStore?: StoreType;
  /** Show multiple store options */
  showStoreOptions?: boolean;
  /** Position in grid for tracking */
  position?: number;
}

const {
  product,
  showRating = true,
  showPrice = true,
  layout = 'grid',
  rank,
  showQuickActions = true,
  showStockStatus = true,
  preferredStore = 'amazon',
  showStoreOptions = false,
  position = 0,
} = Astro.props;

// Get affiliate link from centralized system
const affiliateLink = product.slug 
  ? getAffiliateLink(product.slug, preferredStore)
  : product.affiliateUrl;

// Get price information from centralized system
const priceInfo = product.slug 
  ? getProductPrice(product.slug)
  : null;

// Calculate discount percentage
const discountPercentage = priceInfo?.discount ?? 
  (product.mrp && product.mrp > product.price 
    ? Math.round(((product.mrp - product.price) / product.mrp) * 100)
    : null);

// Calculate savings amount
const savingsAmount = priceInfo?.savings ??
  (product.mrp && product.mrp > product.price 
    ? product.mrp - product.price
    : null);

// Determine stock status
const stockStatus = product.slug 
  ? (isInStock(product.slug, preferredStore) ? 'in-stock' : 'out-of-stock')
  : (product.inStock !== false ? 'in-stock' : 'out-of-stock');
const stockLabel = stockStatus === 'in-stock' ? 'In Stock' : 'Out of Stock';

// Get top features (first 3)
const topFeatures = Object.entries(product.features || {})
  .slice(0, 3)
  .map(([key, value]) => value);

// Current price for display
const displayPrice = priceInfo?.price ?? product.price;
const displayMrp = priceInfo?.mrp ?? product.mrp;
---

<article
  class={`product-card-enhanced group relative bg-[#1A2E35] rounded-xl overflow-hidden border border-[#2a4450]/50 ${layout === 'list' ? 'flex gap-4' : ''} transition-all duration-400 ease-out hover:shadow-card-premium-hover hover:border-[#C46A3A]/30`}
  data-product-id={product.id}
  data-product-slug={product.slug}
  data-affiliate-tracked="true"
>
  <!-- Image Container with Overlay Actions -->
  <div class={`relative overflow-hidden bg-[#0F1F24] ${layout === 'list' ? 'w-48 h-48 flex-shrink-0' : 'aspect-square'}`}>
    <!-- Rank Badge -->
    {rank && rank <= 5 && (
      <div class="absolute top-3 left-3 z-20 px-3 py-1.5 bg-gradient-to-r from-[#C46A3A] to-[#d4834f] text-[#F4F1EA] text-xs font-bold rounded-lg shadow-glow-copper">
        #{rank} Best Seller
      </div>
    )}
    
    <!-- Deal Badge -->
    {discountPercentage && discountPercentage >= 20 && (
      <div class="absolute top-3 right-3 z-20 px-2.5 py-1 bg-gradient-to-r from-[#00b207] to-[#008a05] text-white text-xs font-bold rounded-lg shadow-glow-success">
        {discountPercentage}% OFF
      </div>
    )}
    
    <!-- Product Image with Zoom Effect -->
    <a
      href={affiliateLink}
      target="_blank"
      rel="nofollow sponsored"
      class="block w-full h-full img-zoom"
      data-affiliate-link="true"
      data-store={preferredStore}
    >
      <img
        src={product.imageUrl}
        alt={product.name}
        class="w-full h-full object-contain p-4 transition-transform duration-500 ease-out group-hover:scale-110"
        loading="lazy"
        decoding="async"
        onerror="this.src='/images/placeholder-product.jpg'"
      />
    </a>
    
    <!-- Hover Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#0F1F24]/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    
    <!-- Quick Action Buttons -->
    {showQuickActions && (
      <div class="absolute inset-0 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300">
        <!-- Quick View Button -->
        <button
          type="button"
          class="quick-action-btn quick-view-btn w-12 h-12 bg-[#1A2E35]/90 backdrop-blur-sm border border-[#2a4450] hover:bg-[#C46A3A] hover:border-[#C46A3A] transform translate-y-4 group-hover:translate-y-0"
          aria-label="Quick view"
          data-action="quick-view"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </button>
      </div>
    )}
    
    <!-- Wishlist Button (Top Right) -->
    <button
      type="button"
      class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-[#1A2E35]/80 backdrop-blur-sm border border-[#2a4450]/50 flex items-center justify-center opacity-0 group-hover:opacity-100 translate-x-2 group-hover:translate-x-0 transition-all duration-300 hover:bg-[#C46A3A] hover:border-[#C46A3A] hover:text-[#F4F1EA] text-[#a8b5ba]"
      aria-label="Add to wishlist"
      data-action="wishlist"
      data-product-id={product.id}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    </button>
    
    <!-- Compare Checkbox (Top Left below rank) -->
    <label class={`absolute z-10 flex items-center gap-1.5 px-2 py-1 rounded-lg bg-[#1A2E35]/80 backdrop-blur-sm border border-[#2a4450]/50 cursor-pointer opacity-0 group-hover:opacity-100 transition-all duration-300 hover:border-[#C46A3A]/50 ${rank ? 'top-12' : 'top-3'} left-3`}>
      <input
        type="checkbox"
        class="w-3.5 h-3.5 rounded border-[#2a4450] bg-transparent text-[#C46A3A] focus:ring-[#C46A3A] focus:ring-offset-0 cursor-pointer"
        data-action="compare"
        data-product-id={product.id}
      />
      <span class="text-xs text-[#a8b5ba]">Compare</span>
    </label>
  </div>

  <!-- Product Content -->
  <div class={`flex flex-col ${layout === 'list' ? 'flex-1 py-4 px-2' : 'p-4'}`}>
    <!-- Brand with verified badge -->
    <div class="flex items-center gap-2 mb-1.5">
      <p class="text-xs text-[#6b7d83] uppercase tracking-wide font-medium">
        {product.brand}
      </p>
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-[#00b207]/10 text-[#00b207]">
        ✓ Verified
      </span>
    </div>

    <!-- Product Name -->
    <h3 class="font-semibold text-[#F4F1EA] mb-2 line-clamp-2 leading-snug text-sm group-hover:text-[#d4834f] transition-colors duration-300">
      <a
        href={affiliateLink}
        target="_blank"
        rel="nofollow sponsored"
        class="hover:text-[#C46A3A] transition-colors duration-200"
        data-affiliate-link="true"
      >
        {product.name}
      </a>
    </h3>

    <!-- Rating with review count -->
    {showRating && product.rating > 0 && (
      <div class="flex items-center gap-2 mb-2">
        <RatingStars
          rating={product.rating}
          reviewCount={product.reviewCount}
          size="sm"
        />
      </div>
    )}

    <!-- Enhanced Price Display -->
    {showPrice && (
      <div class="mb-3">
        <div class="price-display">
          <span class="price-current">{formatPrice(displayPrice)}</span>
          {displayMrp && displayMrp > displayPrice && (
            <>
              <span class="price-original">{formatPrice(displayMrp)}</span>
              {discountPercentage && (
                <span class="price-discount-badge">{discountPercentage}% off</span>
              )}
            </>
          )}
        </div>
        {savingsAmount && savingsAmount > 0 && (
          <p class="price-savings-text mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Save {formatPrice(savingsAmount)}
          </p>
        )}
      </div>
    )}

    <!-- Stock Status Indicator -->
    {showStockStatus && (
      <div class={`stock-indicator mb-3 ${stockStatus === 'in-stock' ? 'stock-in-stock' : stockStatus === 'low-stock' ? 'stock-low-stock' : 'stock-out-of-stock'}`}>
        <span class={`stock-dot ${stockStatus === 'in-stock' ? 'stock-dot-in-stock' : stockStatus === 'low-stock' ? 'stock-dot-low-stock' : 'stock-dot-out-of-stock'}`}></span>
        <span>{stockLabel}</span>
      </div>
    )}

    <!-- Key Features -->
    {topFeatures.length > 0 && (
      <ul class="text-xs text-[#a8b5ba] mb-4 space-y-1.5 flex-1">
        {topFeatures.map((feature) => (
          <li class="flex items-start gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#00b207] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            <span class="line-clamp-1">{feature}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Store Options (if enabled) -->
    {showStoreOptions && product.slug && (
      <div class="flex gap-2 mb-3">
        <a
          href={getAffiliateLink(product.slug, 'amazon')}
          target="_blank"
          rel="nofollow sponsored"
          class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-medium bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:border-[#C46A3A]/50 transition-colors"
          data-affiliate-link="true"
          data-store="amazon"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.002 0C5.326 0 0 5.326 0 12.002s5.326 12.002 12.002 12.002 12.002-5.326 12.002-12.002S18.678 0 12.002 0zm0 22.004c-5.514 0-10.002-4.488-10.002-10.002S6.488 2 12.002 2s10.002 4.488 10.002 10.002-4.488 10.002-10.002 10.002z"/>
          </svg>
          Amazon
        </a>
        <a
          href={getAffiliateLink(product.slug, 'flipkart')}
          target="_blank"
          rel="nofollow sponsored"
          class="flex-1 flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-medium bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:border-[#C46A3A]/50 transition-colors"
          data-affiliate-link="true"
          data-store="flipkart"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
          </svg>
          Flipkart
        </a>
      </div>
    )}

    <!-- Enhanced CTA Button -->
    <a
      href={affiliateLink}
      target="_blank"
      rel="nofollow sponsored"
      class="btn-premium text-sm relative overflow-hidden"
      aria-label={`Check price of ${product.name} on ${preferredStore === 'amazon' ? 'Amazon' : 'Flipkart'}`}
      data-affiliate-link="true"
      data-store={preferredStore}
    >
      <svg class="w-4 h-4 relative z-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
      </svg>
      <span class="relative z-10">Check Price on {preferredStore === 'amazon' ? 'Amazon' : 'Flipkart'}</span>
    </a>
      <!-- Share Button -->
      <button
        type="button"
        class="share-btn ml-2 px-3 py-1 text-xs bg-[#0F1F24] border border-[#2a4450] rounded hover:border-[#C46A3A]/50 transition-colors"
        data-action="share"
      >
        Share
      </button>
    
    <!-- Enhanced trust indicator -->
    <div class="flex items-center justify-center gap-3 mt-3 text-[10px] text-[#6b7d83]">
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-[#00b207]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Free Delivery
      </span>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-[#00b207]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Secure
      </span>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-[#00b207]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Easy Returns
      </span>
    </div>
  </div>
  
  <!-- Shine effect on hover -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden rounded-xl">
    <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-out bg-gradient-to-r from-transparent via-white/5 to-transparent"></div>
  </div>
</article>

<style>
  .product-card-enhanced {
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .product-card-enhanced:hover {
    transform: translateY(-8px);
  }
  
  /* Smooth image zoom */
  .img-zoom img {
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Quick action button animations */
  .quick-action-btn {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .product-card-enhanced,
    .product-card-enhanced *,
    .img-zoom img,
    .quick-action-btn {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
    
    .product-card-enhanced:hover {
      transform: none;
    }
  }
</style>

<script>
  // Import tracking functions
  import { trackProductViewEvent, trackProductClickEvent } from '../../utils/analytics';

  // Track product view when card becomes visible
  document.addEventListener('DOMContentLoaded', () => {
    const productCard = document.querySelector('[data-product-id="{product.id}"]');
    if (productCard) {
      // Track view immediately on page load
      trackProductViewEvent('{product.id}', '{product.name}', '{product.category}');
    }
    
    // Affiliate link click tracking
    const affiliateLinks = document.querySelectorAll('[data-affiliate-link="true"]');
    
    affiliateLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const productCard = target.closest('[data-product-slug]');
        const productId = productCard?.getAttribute('data-product-id');
        const productSlug = productCard?.getAttribute('data-product-slug');
        const productName = productCard?.querySelector('h3 a')?.textContent || '';
        const store = target.getAttribute('data-store') || 'amazon';
        const url = target.getAttribute('href') || '';
        
        if (productId) {
          // Track click with analytics
          trackProductClickEvent(productId, productName, '{product.category}', {position});
          
          // Track click in localStorage (existing functionality)
          try {
            const clickEvent = {
              type: 'affiliate_click',
              product: productSlug,
              store,
              url,
              timestamp: new Date().toISOString(),
            };
            
            const clicks = JSON.parse(localStorage.getItem('affiliate_clicks') || '[]');
            clicks.push(clickEvent);
            if (clicks.length > 100) clicks.shift();
            localStorage.setItem('affiliate_clicks', JSON.stringify(clicks));
          } catch (err) {
            console.warn('[Affiliate] Could not track click:', err);
          }
        }
      });
    });
    // Share button handling
    const shareButtons = document.querySelectorAll('[data-action="share"]');
    shareButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const productCard = btn.closest('[data-product-id]');
        const productName = productCard?.querySelector('h3 a')?.textContent || '';
        const url = productCard?.querySelector('[data-affiliate-link="true"]')?.href || '';
        if (navigator.share) {
          navigator.share({ title: productName, url }).catch(() => {});
        } else if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(() => {
            alert('Product link copied to clipboard');
          }).catch(() => {
            alert('Unable to copy link');
          });
        } else {
          alert('Share not supported');
        }
      });
    });
  });
</script>
