---
/**
 * ProsConsList Component for BudgetTechIndia
 * Two-column layout for pros and cons
 */

interface Props {
  /** List of pros/advantages */
  pros: string[];
  /** List of cons/disadvantages */
  cons: string[];
  /** Section title */
  title?: string;
}

const { pros, cons, title } = Astro.props;
---

{(pros.length > 0 || cons.length > 0) && (
  <section class="pros-cons-section">
    {title && (
      <h3 class="font-heading text-h4 text-neutral-900 mb-4">{title}</h3>
    )}

    <div class="grid md:grid-cols-2 gap-6">
      <!-- Pros -->
      {pros.length > 0 && (
        <div class="bg-green-50 rounded-xl p-5">
          <h4 class="flex items-center gap-2 font-semibold text-green-700 mb-3">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Pros
          </h4>
          <ul class="space-y-2">
            {pros.map((pro) => (
              <li class="flex items-start gap-2 text-sm text-neutral-700">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <!-- Cons -->
      {cons.length > 0 && (
        <div class="bg-red-50 rounded-xl p-5">
          <h4 class="flex items-center gap-2 font-semibold text-red-700 mb-3">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
            Cons
          </h4>
          <ul class="space-y-2">
            {cons.map((con) => (
              <li class="flex items-start gap-2 text-sm text-neutral-700">
                <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>
)}
