---
/**
 * ArticleCard Component for BudgetTechIndia
 * Displays article preview with image, title, excerpt, and metadata
 */

import type { Article } from '../../utils/interfaces';
import { formatDate } from '../../utils/helpers';

interface Props {
  /** Article data */
  article: Article;
  /** Whether to show image */
  showImage?: boolean;
  /** Layout variant */
  layout?: 'grid' | 'list' | 'featured';
}

const {
  article,
  showImage = true,
  layout = 'grid',
} = Astro.props;

// Calculate read time (average 200 words per minute)
const wordCount = article.description?.split(/\s+/).length || 0;
const readTime = Math.max(1, Math.ceil(wordCount / 200));

// Get category badge color
const categoryColors: Record<string, string> = {
  review: 'bg-blue-100 text-blue-700',
  top5: 'bg-purple-100 text-purple-700',
  blog: 'bg-green-100 text-green-700',
};

const categoryLabels: Record<string, string> = {
  review: 'Review',
  top5: 'Top 5',
  blog: 'Blog',
};
---

<article
  class={`group ${layout === 'list' ? 'flex gap-6' : ''} ${layout === 'featured' ? 'md:grid md:grid-cols-2 md:gap-8' : ''}`}
>
  <!-- Image -->
  {showImage && (
    <a
      href={`/blog/${article.slug}`}
      class={`block overflow-hidden rounded-xl bg-neutral-100 ${
        layout === 'grid' ? 'aspect-banner mb-4' : ''
      } ${layout === 'list' ? 'w-48 h-32 flex-shrink-0' : ''} ${
        layout === 'featured' ? 'aspect-banner md:aspect-[4/3]' : ''
      }`}
    >
      <img
        src={article.image}
        alt={article.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <!-- Content -->
  <div class={`flex flex-col ${layout === 'featured' ? 'md:justify-center' : ''}`}>
    <!-- Category Badge -->
    <div class="flex items-center gap-2 mb-2">
      <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium ${categoryColors[article.type] || 'bg-neutral-100 text-neutral-700'}`}>
        {categoryLabels[article.type] || article.type}
      </span>
      {article.category && (
        <span class="text-xs text-neutral-500">
          {article.category}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class={`font-heading font-semibold text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors duration-200 ${
      layout === 'featured' ? 'text-h2' : ''
    }`}>
      <a href={`/blog/${article.slug}`}>
        {article.title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class={`text-neutral-600 mb-3 ${layout === 'featured' ? 'text-base' : 'text-sm line-clamp-2'}`}>
      {article.description}
    </p>

    <!-- Meta -->
    <div class="flex items-center gap-4 text-xs text-neutral-500 mt-auto">
      <time datetime={article.pubDate.toISOString()}>
        {formatDate(article.pubDate)}
      </time>
      <span class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {readTime} min read
      </span>
      <span class="flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        {article.author}
      </span>
    </div>
  </div>
</article>
