---
/**
 * JSON-LD Schema Component for BudgetTechIndia
 * Generates structured data for SEO
 */

import type { SchemaType, Product, Article, BreadcrumbItem } from '../../utils/interfaces';
import { formatISODate } from '../../utils/helpers';

interface OrganizationSchema {
  name: string;
  url: string;
  logo: string;
  description: string;
}

interface WebsiteSchema {
  name: string;
  url: string;
  description: string;
}

interface ProductSchema {
  product: Product;
  url: string;
}

interface ArticleSchema {
  article: Article;
  url: string;
  imageUrl: string;
  authorName: string;
}

interface BreadcrumbSchema {
  items: BreadcrumbItem[];
}

interface FAQSchema {
  questions: Array<{
    question: string;
    answer: string;
  }>;
}

type SchemaData = OrganizationSchema | WebsiteSchema | ProductSchema | ArticleSchema | BreadcrumbSchema | FAQSchema;

interface Props {
  type: SchemaType;
  data: SchemaData;
}

const { type, data } = Astro.props;
const siteUrl = import.meta.env.SITE_URL || 'https://budgettechindia.com';

function generateSchema(type: SchemaType, data: SchemaData): object {
  switch (type) {
    case 'organization': {
      const org = data as OrganizationSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: org.name,
        url: org.url,
        logo: {
          '@type': 'ImageObject',
          url: org.logo,
        },
        description: org.description,
        sameAs: [
          'https://twitter.com/budgettechindia',
          'https://facebook.com/budgettechindia',
        ],
      };
    }

    case 'website': {
      const site = data as WebsiteSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: site.name,
        url: site.url,
        description: site.description,
        potentialAction: {
          '@type': 'SearchAction',
          target: {
            '@type': 'EntryPoint',
            urlTemplate: `${site.url}/search?q={search_term_string}`,
          },
          'query-input': 'required name=search_term_string',
        },
      };
    }

    case 'product': {
      const { product, url } = data as ProductSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: product.name,
        description: product.features?.description || product.name,
        image: product.imageUrl,
        brand: {
          '@type': 'Brand',
          name: product.brand,
        },
        offers: {
          '@type': 'Offer',
          url: url,
          priceCurrency: 'INR',
          price: product.price,
          priceValidUntil: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
          availability: product.isActive ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
          seller: {
            '@type': 'Organization',
            name: 'Amazon India',
          },
        },
        aggregateRating: product.rating > 0 ? {
          '@type': 'AggregateRating',
          ratingValue: product.rating,
          reviewCount: product.reviewCount,
          bestRating: 5,
          worstRating: 1,
        } : undefined,
        review: product.rating > 0 ? {
          '@type': 'Review',
          reviewRating: {
            '@type': 'Rating',
            ratingValue: product.rating,
            bestRating: 5,
          },
          author: {
            '@type': 'Organization',
            name: 'BudgetTechIndia',
          }
        } : undefined,
      };
    }

    case 'article': {
      const { article, url, imageUrl, authorName } = data as ArticleSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: article.title,
        description: article.description,
        image: imageUrl,
        author: {
          '@type': 'Person',
          name: authorName,
        },
        publisher: {
          '@type': 'Organization',
          name: 'BudgetTechIndia',
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/images/logo.png`,
          },
        },
        datePublished: formatISODate(article.pubDate),
        dateModified: article.updatedDate ? formatISODate(article.updatedDate) : formatISODate(article.pubDate),
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': url,
        },
      };
    }

    case 'breadcrumb': {
      const { items } = data as BreadcrumbSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: items.map((item, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: item.name,
          item: item.url ? `${siteUrl}${item.url}` : undefined,
        })),
      };
    }

    case 'faq': {
      const { questions } = data as FAQSchema;
      return {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: questions.map((q) => ({
          '@type': 'Question',
          name: q.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: q.answer,
          },
        })),
      };
    }

    default:
      return {};
  }
}

const schema = generateSchema(type, data);
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
