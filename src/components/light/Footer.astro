---
import { getActiveVariation } from '../../utils/variation';

const variation = getActiveVariation();
const isLightTheme = variation === 'light';
---

<footer class={`footer ${isLightTheme ? 'light-theme' : 'dark-theme'}`} role="contentinfo">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section">
        <h3 class="footer-title">About TechStore</h3>
        <p class="footer-description">
          Your trusted source for honest tech product reviews and recommendations. 
          We help you find the best products at the right price.
        </p>
        <div class="social-links">
          <a href="#" class="social-link" aria-label="Facebook">
            <span>📘</span>
          </a>
          <a href="#" class="social-link" aria-label="Twitter">
            <span>🐦</span>
          </a>
          <a href="#" class="social-link" aria-label="Instagram">
            <span>📷</span>
          </a>
          <a href="#" class="social-link" aria-label="YouTube">
            <span>📺</span>
          </a>
        </div>
      </div>

      <div class="footer-section">
        <h3 class="footer-title">Quick Links</h3>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/categories">Categories</a></li>
          <li><a href="/reviews">Reviews</a></li>
          <li><a href="/top-5">Top 5</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3 class="footer-title">Categories</h3>
        <ul class="footer-links">
          <li><a href="/categories/smartphones">Smartphones</a></li>
          <li><a href="/categories/laptops">Laptops</a></li>
          <li><a href="/categories/headphones">Headphones</a></li>
          <li><a href="/categories/smartwatches">Smartwatches</a></li>
          <li><a href="/categories/accessories">Accessories</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3 class="footer-title">Legal</h3>
        <ul class="footer-links">
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms-conditions">Terms & Conditions</a></li>
          <li><a href="/affiliate-disclosure">Affiliate Disclosure</a></li>
          <li><a href="/contact">Contact Us</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-copyright">
        <p>&copy; {new Date().getFullYear()} TechStore. All rights reserved.</p>
      </div>
      <div class="footer-trust">
        <span>Secure Shopping</span>
        <span>Verified Reviews</span>
        <span>24/7 Support</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #F9FAFB;
    border-top: 1px solid #E5E7EB;
    padding: 4rem 0 2rem;
    color: #6B7280;
  }

  .footer-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .footer-section {
    display: flex;
    flex-direction: column;
  }

  .footer-title {
    color: #1F2937;
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .footer-description {
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: #6B7280;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 0.5rem;
  }

  .footer-links a {
    color: #6B7280;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .footer-links a:hover {
    color: #3B82F6;
    transform: translateX(4px);
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 50%;
    color: #6B7280;
    text-decoration: none;
    transition: all 0.3s ease;
    font-size: 1.25rem;
  }

  .social-link:hover {
    background: #3B82F6;
    color: #FFFFFF;
    border-color: #3B82F6;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .footer-bottom {
    border-top: 1px solid #E5E7EB;
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
  }

  .footer-copyright {
    color: #6B7280;
  }

  .footer-trust {
    display: flex;
    justify-content: center;
    gap: 2rem;
    font-size: 0.875rem;
    color: #6B7280;
  }

  .footer-trust span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0 1rem;
    }

    .footer-container {
      padding: 0 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .footer-bottom {
      padding-top: 1.5rem;
    }

    .footer-trust {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  /* Animation effects */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .footer-section {
    animation: fadeInUp 0.6s ease forwards;
  }

  .footer-section:nth-child(1) {
    animation-delay: 0.1s;
  }

  .footer-section:nth-child(2) {
    animation-delay: 0.2s;
  }

  .footer-section:nth-child(3) {
    animation-delay: 0.3s;
  }

  .footer-section:nth-child(4) {
    animation-delay: 0.4s;
  }
</style>