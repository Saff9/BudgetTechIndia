---
/**
 * BackToTop Component for BudgetTechIndia
 * Premium Dark Theme - Floating button with glow effect and smooth animations
 */

interface Props {
  /** Show after scrolling this many pixels */
  showAfter?: number;
  /** Position from bottom */
  bottom?: string;
  /** Position from right */
  right?: string;
  /** Button size */
  size?: 'sm' | 'md' | 'lg';
  /** Show progress indicator */
  showProgress?: boolean;
}

const {
  showAfter = 300,
  bottom = '2rem',
  right = '2rem',
  size = 'md',
  showProgress = true
} = Astro.props;

// Size classes
const sizeClasses = {
  sm: 'w-10 h-10',
  md: 'w-12 h-12',
  lg: 'w-14 h-14',
};

const iconSizes = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};
---

<button
  id="back-to-top-btn"
  class={`back-to-top ${sizeClasses[size]}`}
  style={`bottom: ${bottom}; right: ${right};`}
  aria-label="Back to top"
  data-show-after={showAfter}
>
  {/* Progress ring */}
  {showProgress && (
    <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 48 48">
      <circle
        cx="24"
        cy="24"
        r="22"
        fill="none"
        stroke="rgba(42, 68, 80, 0.5)"
        stroke-width="2"
      />
      <circle
        id="progress-circle"
        cx="24"
        cy="24"
        r="22"
        fill="none"
        stroke="url(#progress-gradient)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="138.23"
        stroke-dashoffset="138.23"
        class="transition-all duration-150 ease-out"
      />
      <defs>
        <linearGradient id="progress-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#C46A3A" />
          <stop offset="100%" stop-color="#d4834f" />
        </linearGradient>
      </defs>
    </svg>
  )}
  
  {/* Icon */}
  <svg 
    class={`relative z-10 ${iconSizes[size]} text-[#F4F1EA] group-hover:-translate-y-0.5 transition-transform duration-300`} 
    fill="none" 
    stroke="currentColor" 
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
  
  {/* Hover glow */}
  <span class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-[#C46A3A]/20 blur-xl"></span>
</button>

<style>
  .back-to-top {
    position: fixed;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #C46A3A 0%, #a55a30 100%);
    box-shadow: 
      0 4px 15px rgba(196, 106, 58, 0.4),
      0 2px 4px rgba(0, 0, 0, 0.2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.8);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: none;
    outline: none;
  }
  
  .back-to-top:hover {
    box-shadow: 
      0 8px 25px rgba(196, 106, 58, 0.5),
      0 4px 8px rgba(0, 0, 0, 0.3);
    transform: translateY(0) scale(1.1);
  }
  
  .back-to-top:active {
    transform: translateY(0) scale(1);
  }
  
  .back-to-top:focus-visible {
    outline: 2px solid #C46A3A;
    outline-offset: 2px;
  }
  
  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  
  /* Pulse animation on hover */
  .back-to-top::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C46A3A 0%, #d4834f 100%);
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
  }
  
  .back-to-top:hover::before {
    animation: pulse-ring 1.5s ease-out infinite;
  }
  
  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top *,
    .back-to-top::before {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const backToTopBtn = document.getElementById('back-to-top-btn');
  const progressCircle = document.getElementById('progress-circle');
  const showAfter = parseInt(backToTopBtn?.dataset.showAfter || '300');
  
  // Calculate scroll progress
  function getScrollProgress(): number {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    return docHeight > 0 ? scrollTop / docHeight : 0;
  }
  
  // Update button visibility and progress
  function updateBackToTop(): void {
    if (!backToTopBtn) return;
    
    const scrollTop = window.scrollY;
    const progress = getScrollProgress();
    
    // Show/hide button
    if (scrollTop > showAfter) {
      backToTopBtn.classList.add('visible');
    } else {
      backToTopBtn.classList.remove('visible');
    }
    
    // Update progress circle
    if (progressCircle) {
      const circumference = 2 * Math.PI * 22; // r = 22
      const offset = circumference - (progress * circumference);
      progressCircle.style.strokeDashoffset = offset.toString();
    }
  }
  
  // Scroll to top
  function scrollToTop(): void {
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }
  
  // Event listeners
  backToTopBtn?.addEventListener('click', scrollToTop);
  
  // Throttled scroll listener
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        updateBackToTop();
        ticking = false;
      });
      ticking = true;
    }
  });
  
  // Initial check
  updateBackToTop();
</script>
