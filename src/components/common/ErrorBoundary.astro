---
/**
 * Error Boundary Component for BudgetTechIndia
 * Graceful error handling with user-friendly messages
 */

interface Props {
  /** Error type */
  type?: '404' | '500' | 'generic';
  /** Custom error title */
  title?: string;
  /** Custom error message */
  message?: string;
  /** Show home button */
  showHomeButton?: boolean;
  /** Show back button */
  showBackButton?: boolean;
}

const {
  type = 'generic',
  title,
  message,
  showHomeButton = true,
  showBackButton = true
} = Astro.props;

const errorConfig = {
  '404': {
    title: 'Page Not Found',
    message: "The page you're looking for doesn't exist or has been moved.",
    icon: `<svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`
  },
  '500': {
    title: 'Server Error',
    message: "Something went wrong on our end. Please try again later.",
    icon: `<svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>`
  },
  'generic': {
    title: 'Oops!',
    message: "Something went wrong. Please try again.",
    icon: `<svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`
  }
};

const config = errorConfig[type];
---

<div class="error-boundary">
  <div class="error-content">
    <div class="error-icon">
      <Fragment set:html={config.icon} />
    </div>
    
    <h1 class="error-title">{title || config.title}</h1>
    <p class="error-message">{message || config.message}</p>
    
    <div class="error-actions">
      {showBackButton && (
        <button 
          onclick="history.back()" 
          class="btn-back"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Go Back
        </button>
      )}
      
      {showHomeButton && (
        <a href="/" class="btn-home">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          Back to Home
        </a>
      )}
    </div>
    
    <div class="error-help">
      <p>Need help? <a href="/contact">Contact us</a></p>
    </div>
  </div>
</div>

<style>
  .error-boundary {
    @apply min-h-[60vh] flex items-center justify-center p-4 sm:p-8;
  }
  
  .error-content {
    @apply text-center max-w-md;
  }
  
  .error-icon {
    @apply text-[#2a4450] mb-6 flex justify-center;
  }
  
  .error-title {
    @apply text-2xl sm:text-3xl font-bold text-[#F4F1EA] mb-3;
  }
  
  .error-message {
    @apply text-[#a8b5ba] text-sm sm:text-base mb-8;
  }
  
  .error-actions {
    @apply flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4;
  }
  
  .btn-back,
  .btn-home {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-semibold rounded-lg transition-all duration-200;
  }
  
  .btn-back {
    @apply bg-[#1A2E35] text-[#F4F1EA] border border-[#2a4450] hover:border-[#C46A3A] hover:text-[#C46A3A];
  }
  
  .btn-home {
    @apply bg-gradient-to-r from-[#C46A3A] to-[#d4834f] text-[#F4F1EA] hover:from-[#d4834f] hover:to-[#C46A3A];
  }
  
  .error-help {
    @apply mt-8 text-xs sm:text-sm text-[#6b7d83];
  }
  
  .error-help a {
    @apply text-[#C46A3A] hover:text-[#d4834f] transition-colors;
  }
</style>
