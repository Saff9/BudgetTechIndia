---
/**
 * Loading States Component for BudgetTechIndia
 * Professional loading, error, and empty states
 */

interface Props {
  /** Type of state to display */
  type: 'loading' | 'error' | 'empty';
  /** Custom message to display */
  message?: string;
  /** Size variant */
  size?: 'sm' | 'md' | 'lg';
  /** Additional CSS classes */
  class?: string;
}

const {
  type,
  message,
  size = 'md',
  class: className = ''
} = Astro.props;

const sizeClasses = {
  sm: 'p-4',
  md: 'p-8',
  lg: 'p-12'
};

const defaultMessages = {
  loading: 'Loading...',
  error: 'Something went wrong',
  empty: 'No items found'
};
---

<div class={`state-container ${sizeClasses[size]} ${className}`}>
  {type === 'loading' && (
    <div class="loading-state">
      <div class="loading-spinner"></div>
      <p class="state-message">{message || defaultMessages.loading}</p>
    </div>
  )}
  
  {type === 'error' && (
    <div class="error-state">
      <div class="error-icon">
        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <p class="state-message">{message || defaultMessages.error}</p>
      <button 
        class="retry-button"
        onclick="window.location.reload()"
      >
        Try Again
      </button>
    </div>
  )}
  
  {type === 'empty' && (
    <div class="empty-state">
      <div class="empty-icon">
        <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
        </svg>
      </div>
      <p class="state-message">{message || defaultMessages.empty}</p>
      <a href="/" class="browse-button">
        Browse Products
      </a>
    </div>
  )}
</div>

<style>
  .state-container {
    @apply flex items-center justify-center text-center;
  }
  
  .loading-state,
  .error-state,
  .empty-state {
    @apply flex flex-col items-center gap-4;
  }
  
  /* Loading Spinner */
  .loading-spinner {
    @apply w-10 h-10 rounded-full;
    border: 3px solid rgba(196, 106, 58, 0.2);
    border-top-color: #C46A3A;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  /* Error State */
  .error-icon {
    @apply text-[#df0000];
  }
  
  /* Empty State */
  .empty-icon {
    @apply text-[#2a4450];
  }
  
  .state-message {
    @apply text-[#a8b5ba] text-sm sm:text-base;
  }
  
  /* Buttons */
  .retry-button,
  .browse-button {
    @apply mt-2 px-5 py-2.5 text-sm font-semibold rounded-lg transition-all duration-200;
  }
  
  .retry-button {
    @apply bg-[#1A2E35] text-[#F4F1EA] border border-[#2a4450] hover:border-[#C46A3A] hover:text-[#C46A3A];
  }
  
  .browse-button {
    @apply bg-gradient-to-r from-[#C46A3A] to-[#d4834f] text-[#F4F1EA] hover:from-[#d4834f] hover:to-[#C46A3A];
  }
</style>
