---
/**
 * Affiliate Disclosure Component for BudgetTechIndia
 * Displays prominent affiliate disclosure banner
 */

interface Props {
  /** Variant of disclosure display */
  variant?: 'banner' | 'inline' | 'compact';
  /** Whether to show icon */
  showIcon?: boolean;
}

const { variant = 'banner', showIcon = true } = Astro.props;

const disclosureText = "This website contains affiliate links. As an Amazon Associate, we earn from qualifying purchases. We may earn a commission at no additional cost to you.";
---

{variant === 'banner' && (
  <div class="affiliate-disclosure bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-lg text-sm text-neutral-700" role="alert">
    <div class="flex items-start gap-3">
      {showIcon && (
        <svg class="w-5 h-5 text-amber-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
      )}
      <div>
        <p class="font-medium text-amber-800 mb-1">Affiliate Disclosure</p>
        <p>{disclosureText}</p>
      </div>
    </div>
  </div>
)}

{variant === 'inline' && (
  <p class="text-xs text-neutral-500 italic">
    {showIcon && (
      <svg class="w-3.5 h-3.5 inline-block mr-1 text-amber-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
    )}
    {disclosureText}
  </p>
)}

{variant === 'compact' && (
  <div class="bg-neutral-100 px-3 py-2 rounded text-xs text-neutral-600 flex items-center gap-2">
    {showIcon && (
      <svg class="w-4 h-4 text-amber-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
      </svg>
    )}
    <span>Contains affiliate links. We earn from qualifying purchases.</span>
  </div>
)}
