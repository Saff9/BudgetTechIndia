---
/**
 * Footer Component for BudgetTechIndia
 * Premium Dark Theme - Enhanced with newsletter, payment icons, trust badges
 */

const currentYear = new Date().getFullYear();

const categoryLinks = [
  { label: 'Bluetooth Earbuds', href: '/categories/bluetooth-earbuds' },
  { label: 'Power Banks', href: '/categories/power-banks' },
  { label: 'Fast Chargers & Cables', href: '/categories/fast-chargers-cables' },
  { label: 'Smartwatches', href: '/categories/smartwatches' },
  { label: 'Laptop Accessories', href: '/categories/laptop-accessories' },
  { label: 'Budget Gadgets Under ₹999', href: '/categories/budget-gadgets-under-999' },
  { label: 'Work From Home Essentials', href: '/categories/work-from-home-essentials' },
];

const quickLinks = [
  { label: 'Home', href: '/' },
  { label: 'Reviews', href: '/reviews' },
  { label: 'Blog', href: '/blog' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const legalLinks = [
  { label: 'Privacy Policy', href: '/privacy-policy' },
  { label: 'Terms of Service', href: '/terms-of-service' },
  { label: 'Affiliate Disclosure', href: '/affiliate-disclosure' },
];

import { siteConfig } from '../../utils/siteConfig';

const socialLinks = [
  { label: 'Twitter/X', href: siteConfig.social.twitter.url, icon: 'twitter' },
  { label: 'YouTube', href: siteConfig.social.youtube.url, icon: 'youtube' },
  { label: 'Instagram', href: siteConfig.social.instagram.url, icon: 'instagram' },
  { label: 'LinkedIn', href: siteConfig.social.linkedin.url, icon: 'linkedin' },
];

// Payment methods
const paymentMethods = [
  { name: 'Visa', icon: 'visa' },
  { name: 'Mastercard', icon: 'mastercard' },
  { name: 'UPI', icon: 'upi' },
  { name: 'PayPal', icon: 'paypal' },
  { name: 'Net Banking', icon: 'netbanking' },
];

// Trust badges
const trustBadges = [
  { label: 'Secure Shopping', icon: 'shield' },
  { label: 'Verified Reviews', icon: 'check-badge' },
  { label: 'Trusted Platform', icon: 'star' },
];
---

<footer class="relative bg-[#0a1619] text-[#a8b5ba] mt-auto overflow-hidden">
  <!-- Decorative top border -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[#C46A3A]/50 to-transparent"></div>
  
  <!-- Background decoration -->
  <div class="absolute inset-0 decorative-dots opacity-30" aria-hidden="true"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-[#C46A3A]/5 rounded-full blur-3xl" aria-hidden="true"></div>
  
  <!-- Back to Top -->
  <button 
    id="back-to-top"
    class="relative w-full py-3 bg-[#1A2E35]/50 hover:bg-[#243d46]/50 text-sm text-[#F4F1EA] transition-all duration-300 border-b border-[#2a4450]/50 group flex items-center justify-center gap-2"
    aria-label="Back to top"
  >
    <svg class="w-4 h-4 group-hover:-translate-y-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
    Back to top
  </button>

  <!-- Affiliate Disclosure Banner -->
  <div class="relative bg-gradient-to-r from-[#C46A3A]/10 via-[#C46A3A]/5 to-[#C46A3A]/10 border-b border-[#2a4450]/50">
    <div class="container py-4">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 bg-[#C46A3A]/20 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg class="w-4 h-4 text-[#C46A3A]" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
          </svg>
        </div>
        <p class="text-sm text-[#a8b5ba] leading-relaxed">
          <strong class="text-[#F4F1EA]">Affiliate Disclosure:</strong> 
          This website contains affiliate links. As an Amazon Associate, we earn from qualifying purchases. 
          We may earn a commission at no additional cost to you.
        </p>
      </div>
    </div>
  </div>

  <!-- Newsletter Section -->
  <div class="relative border-b border-[#2a4450]/50">
    <div class="container py-10">
      <div class="newsletter-premium max-w-4xl mx-auto">
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-6">
          <div class="flex-1 text-center md:text-left">
            <h3 class="text-xl font-bold text-[#F4F1EA] mb-2">
              Get the Best Deals in Your Inbox
            </h3>
            <p class="text-sm text-[#a8b5ba]">
              Subscribe for weekly deals, new reviews, and exclusive buying guides.
            </p>
          </div>
          <form class="flex-1 w-full max-w-md">
            <div class="flex gap-2">
              <input
                type="email"
                placeholder="Enter your email"
                class="newsletter-input flex-1"
                required
              />
              <button
                type="submit"
                class="btn-premium px-6 py-3 whitespace-nowrap"
              >
                Subscribe
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
            <p class="text-xs text-[#6b7d83] mt-2">
              🔒 No spam, unsubscribe anytime. We respect your privacy.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="relative container py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-8">
      <!-- Brand Column -->
      <div class="col-span-2 md:col-span-4 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-5 group">
          <div class="relative w-10 h-10 rounded-lg flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-[#C46A3A] to-[#a55a30] group-hover:scale-110 transition-transform duration-300"></div>
            <svg class="relative w-5 h-5 text-[#F4F1EA] z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-lg leading-tight text-[#F4F1EA] tracking-tight">BudgetTech</span>
            <span class="text-[10px] text-[#C46A3A] font-bold tracking-widest -mt-0.5">INDIA</span>
          </div>
        </a>
        <p class="text-sm text-[#a8b5ba] mb-6 leading-relaxed">
          Your trusted source for honest tech product reviews under ₹2,000. 
          We help budget-conscious Indian consumers make informed purchasing decisions.
        </p>
        
        <!-- Social Links with enhanced styling -->
        <div class="flex items-center gap-2 mb-6">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-9 h-9 bg-[#1A2E35]/80 hover:bg-[#C46A3A] rounded-lg flex items-center justify-center text-[#a8b5ba] hover:text-[#F4F1EA] transition-all duration-300 border border-[#2a4450]/50 hover:border-[#C46A3A] hover:scale-110 hover:shadow-glow-copper"
              aria-label={link.label}
            >
              {link.icon === 'twitter' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {link.icon === 'facebook' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />
                </svg>
              )}
              {link.icon === 'instagram' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.378.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
                </svg>
              )}
              {link.icon === 'youtube' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
            </a>
          ))}
        </div>
        
        <!-- Trust Badges -->
        <div class="flex flex-wrap gap-3">
          {trustBadges.map((badge) => (
            <div class="flex items-center gap-1.5 px-2 py-1 bg-[#1A2E35]/50 rounded-lg border border-[#2a4450]/30">
              {badge.icon === 'shield' && (
                <svg class="w-4 h-4 text-[#00b207]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {badge.icon === 'check-badge' && (
                <svg class="w-4 h-4 text-[#00b207]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              )}
              {badge.icon === 'star' && (
                <svg class="w-4 h-4 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
              )}
              <span class="text-xs text-[#a8b5ba]">{badge.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h3 class="font-semibold text-[#F4F1EA] mb-4 text-sm uppercase tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-[#C46A3A] rounded-full"></span>
          Quick Links
        </h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[#a8b5ba] hover:text-[#C46A3A] transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <svg class="w-3 h-3 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories Column -->
      <div>
        <h3 class="font-semibold text-[#F4F1EA] mb-4 text-sm uppercase tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-[#C46A3A] rounded-full"></span>
          Categories
        </h3>
        <ul class="space-y-2.5">
          {categoryLinks.slice(0, 5).map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[#a8b5ba] hover:text-[#C46A3A] transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <svg class="w-3 h-3 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- More Categories Column -->
      <div class="hidden lg:block">
        <h3 class="font-semibold text-[#F4F1EA] mb-4 text-sm uppercase tracking-wide">&nbsp;</h3>
        <ul class="space-y-2.5">
          {categoryLinks.slice(5).map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[#a8b5ba] hover:text-[#C46A3A] transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <svg class="w-3 h-3 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Column -->
      <div>
        <h3 class="font-semibold text-[#F4F1EA] mb-4 text-sm uppercase tracking-wide flex items-center gap-2">
          <span class="w-1 h-4 bg-[#C46A3A] rounded-full"></span>
          Legal
        </h3>
        <ul class="space-y-2.5">
          {legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-[#a8b5ba] hover:text-[#C46A3A] transition-colors duration-200 flex items-center gap-1.5 group"
              >
                <svg class="w-3 h-3 opacity-0 -ml-4 group-hover:opacity-100 group-hover:ml-0 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Payment Methods & Social Proof -->
  <div class="relative border-t border-[#2a4450]/50">
    <div class="container py-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <!-- Payment Methods -->
        <div class="flex items-center gap-4">
          <span class="text-xs text-[#6b7d83]">We Accept:</span>
          <div class="payment-icons">
            {paymentMethods.map((method) => (
              <div class="payment-icon" title={method.name}>
                {method.icon === 'visa' && (
                  <span class="text-xs font-bold text-[#1A1F71]">VISA</span>
                )}
                {method.icon === 'mastercard' && (
                  <span class="text-xs font-bold text-[#EB001B]">MC</span>
                )}
                {method.icon === 'upi' && (
                  <span class="text-xs font-bold text-[#5F259F]">UPI</span>
                )}
                {method.icon === 'paypal' && (
                  <span class="text-xs font-bold text-[#003087]">PP</span>
                )}
                {method.icon === 'netbanking' && (
                  <span class="text-xs font-bold text-[#6b7d83]">NB</span>
                )}
              </div>
            ))}
          </div>
        </div>
        
        <!-- Social Proof -->
        <div class="social-proof">
          <div class="social-proof-item">
            <span class="social-proof-number">100+</span>
            <span>Reviews</span>
          </div>
          <div class="social-proof-item">
            <span class="social-proof-number">50K+</span>
            <span>Monthly Readers</span>
          </div>
          <div class="social-proof-item">
            <span class="social-proof-number">4.8★</span>
            <span>Rating</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Copyright Bar -->
  <div class="relative bg-[#050e10] border-t border-[#2a4450]/50">
    <div class="container py-5">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-sm text-[#6b7d83]">
          © {currentYear} BudgetTechIndia. All rights reserved.
        </p>
        <p class="text-sm text-[#6b7d83] flex items-center gap-1.5">
          Made with <span class="text-[#C46A3A] animate-pulse">❤️</span> in India for Indian consumers
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  // Back to top functionality
  const backToTop = document.getElementById('back-to-top');
  
  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
