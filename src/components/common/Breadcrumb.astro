---
/**
 * Breadcrumb Component for BudgetTechIndia
 * Displays breadcrumb navigation with Schema.org markup
 */

import type { BreadcrumbItem } from '../../utils/interfaces';
import JsonLD from '../seo/JsonLD.astro';

interface Props {
  /** Array of breadcrumb items */
  items: BreadcrumbItem[];
  /** Whether to show Schema.org markup */
  showSchema?: boolean;
}

const { items, showSchema = true } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-neutral-600">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <svg
              class="w-4 h-4 text-neutral-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
          )}
          {item.url && !isLast ? (
            <a
              href={item.url}
              class="hover:text-primary-600 transition-colors duration-200"
            >
              {item.name}
            </a>
          ) : (
            <span
              class={isLast ? 'font-medium text-neutral-900' : ''}
              aria-current={isLast ? 'page' : undefined}
            >
              {item.name}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>

{showSchema && items.length > 0 && (
  <JsonLD type="breadcrumb" data={{ items }} />
)}
