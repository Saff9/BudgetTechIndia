---
/**
 * Ads Component for BudgetTechIndia
 * Manages multiple ad network scripts in a clean, organized manner
 * Supports dynamic ad loading with premium styling
 */

interface Props {
  /** Position where the ad will be displayed */
  position?: 'header' | 'sidebar' | 'in-article' | 'footer';
}

const { position = 'in-article' } = Astro.props;

// Ad slot IDs for different positions
const adSlots = {
  header: 'container-0c544f97ca18152424b528f1feff4406',
  sidebar: 'container-0c544f97ca18152424b528f1feff4406',
  'in-article': 'container-0c544f97ca18152424b528f1feff4406',
  footer: 'container-0c544f97ca18152424b528f1feff4406',
};

const bannerAdKey = '68f6f7339d5cae7a2b5bf2a4aec60aa9';
---

<!-- Ad Container Wrapper -->
<div class={`ad-wrapper ad-${position}`}>
  <!-- Banner Ad (468x60) -->
  <div class="banner-ad-container">
    <script define:vars={{ bannerAdKey }}>
      var atOptions = {
        'key': bannerAdKey,
        'format': 'iframe',
        'height': 60,
        'width': 468,
        'params': {}
      };
    </script>
    <script src={`https://www.highperformanceformat.com/${bannerAdKey}/invoke.js`}></script>
  </div>
  
  <!-- CPM Ad Container -->
  <div class="cpm-ad-container">
    <script async data-cfasync="false" src="https://pl28765501.effectivegatecpm.com/0c544f97ca18152424b528f1feff4406/invoke.js"></script>
    <div id="container-0c544f97ca18152424b528f1feff4406"></div>
  </div>
</div>

<style>
  .ad-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px;
    margin: 24px auto;
    max-width: 100%;
    background: linear-gradient(135deg, rgba(15, 31, 36, 0.9) 0%, rgba(20, 40, 48, 0.95) 100%);
    border-radius: 12px;
    border: 1px solid rgba(196, 106, 58, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .ad-wrapper:hover {
    border-color: rgba(196, 106, 58, 0.6);
    box-shadow: 0 6px 24px rgba(196, 106, 58, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .banner-ad-container {
    min-height: 60px;
    min-width: 468px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    overflow: hidden;
  }

  .cpm-ad-container {
    min-height: 250px;
    min-width: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Premium shine effect */
  .ad-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
    animation: shimmer 3s infinite;
    pointer-events: none;
  }

  @keyframes shimmer {
    0% {
      left: -100%;
    }
    50%, 100% {
      left: 100%;
    }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .banner-ad-container {
      min-height: 50px;
      min-width: 320px;
      transform: scale(0.9);
    }

    .cpm-ad-container {
      min-width: 280px;
    }

    .ad-wrapper {
      padding: 12px;
      margin: 16px auto;
    }
  }

  @media (min-width: 768px) {
    .ad-wrapper {
      flex-direction: row;
      gap: 24px;
    }
  }

  /* Loading skeleton animation */
  .ad-wrapper.loading {
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }
</style>

<script>
  // Add loading class initially, remove when ads load
  document.addEventListener('DOMContentLoaded', () => {
    const adWrappers = document.querySelectorAll('.ad-wrapper');
    adWrappers.forEach(wrapper => {
      wrapper.classList.add('loading');
      
      // Remove loading class after a delay or when iframes load
      setTimeout(() => {
        wrapper.classList.remove('loading');
      }, 2000);
    });
  });

  // Listen for ad load events
  window.addEventListener('load', () => {
    setTimeout(() => {
      document.querySelectorAll('.ad-wrapper').forEach(wrapper => {
        wrapper.classList.remove('loading');
      });
    }, 1500);
  });
</script>
