---
/**
 * Amazon Affiliate Link Auto-Generator Tool Component for Admin Panel
 */
---

<div class="bg-[#12262D] border border-[#2a4450] rounded-xl p-6 mb-8 text-[#F4F1EA]">
  <div class="flex items-center space-x-3 mb-4">
    <div class="w-10 h-10 rounded-lg bg-[#FF9900]/20 flex items-center justify-center border border-[#FF9900]/40">
      <svg class="w-6 h-6 text-[#FF9900]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M15.93 17.09c-2.83 2.09-6.9 3.12-10.43 1.58-1.07-.47-2.02-1.12-2.84-1.92-.31-.3-.21-.83.21-.83.29 0 .61.12.9.27 2.76 1.48 6.09 1.49 8.94.27.76-.32 1.51-.76 2.19-1.3.38-.3.94.13.73.93zm1.62-2.15c-.47-.48-1.14-.68-1.78-.53-.16.04-.26.19-.24.35.04.28.2.53.47.67.92.48 2.02.26 2.68-.45.22-.24.11-.63-.22-.72-.3-.08-.62.24-.91.68zM19.8 19c-3.76 2.8-9.08 3.51-13.62 1.6-1.57-.66-2.98-1.63-4.14-2.85-.36-.38-.07-1 .44-.82.35.12.72.28 1.08.42 4.14 1.57 8.95.84 12.39-1.68.79-.58 1.51-1.27 2.13-2.05.35-.44 1.01-.13.91.43-.16.92-.66 1.77-1.19 2.55z" />
      </svg>
    </div>
    <div>
      <h3 class="text-lg font-bold text-[#F4F1EA]">Automated Amazon Affiliate Generator</h3>
      <p class="text-xs text-[#a8b5ba]">Active Store Tag: <span class="font-mono text-[#FF9900] bg-[#0F1F24] px-2 py-0.5 rounded border border-[#FF9900]/30 font-bold">budgettechpro-21</span></p>
    </div>
  </div>

  <div class="space-y-4">
    <div>
      <label for="amazon-url-input" class="block text-sm font-medium text-[#F4F1EA] mb-1">
        Paste Amazon Product URL or ASIN:
      </label>
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="text"
          id="amazon-url-input"
          placeholder="e.g. https://www.amazon.in/dp/B07BCH6JQK or B07BCH6JQK"
          class="flex-1 px-4 py-2.5 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#FF9900]"
        />
        <button
          type="button"
          id="generate-link-btn"
          class="px-5 py-2.5 bg-[#FF9900] hover:bg-[#e08700] text-[#0F1F24] font-bold text-sm rounded-lg transition-colors flex items-center justify-center space-x-2"
        >
          <span>Generate Affiliate Link</span>
        </button>
      </div>
    </div>

    <!-- Result Display -->
    <div id="link-result-box" class="hidden p-4 rounded-lg bg-[#0F1F24] border border-[#FF9900]/40">
      <div class="flex justify-between items-center mb-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-[#a8b5ba]">Generated Link:</span>
        <span id="asin-badge" class="text-xs font-mono bg-[#FF9900]/20 text-[#FF9900] px-2 py-0.5 rounded">ASIN: </span>
      </div>
      <div class="flex items-center space-x-2">
        <input
          type="text"
          id="generated-url-output"
          readonly
          class="flex-1 px-3 py-2 bg-[#12262D] border border-[#2a4450] rounded text-xs font-mono text-[#F4F1EA] select-all focus:outline-none"
        />
        <button
          type="button"
          id="copy-link-btn"
          class="px-4 py-2 bg-[#2a4450] hover:bg-[#3a5866] text-[#F4F1EA] text-xs font-medium rounded transition-colors"
        >
          Copy Link
        </button>
        <a
          id="test-link-btn"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-[#C46A3A] hover:bg-[#b05c2e] text-white text-xs font-medium rounded transition-colors"
        >
          Test Link ↗
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import { convertToAffiliateUrl } from '../../utils/amazonAutoAffiliate';

  const inputEl = document.getElementById('amazon-url-input') as HTMLInputElement;
  const generateBtn = document.getElementById('generate-link-btn');
  const resultBox = document.getElementById('link-result-box');
  const outputEl = document.getElementById('generated-url-output') as HTMLInputElement;
  const asinBadge = document.getElementById('asin-badge');
  const copyBtn = document.getElementById('copy-link-btn');
  const testBtn = document.getElementById('test-link-btn') as HTMLAnchorElement;

  function generateLink() {
    if (!inputEl || !outputEl || !resultBox) return;
    const val = inputEl.value.trim();
    if (!val) return;

    const res = convertToAffiliateUrl(val, 'budgettechpro-21');
    if (res.success && res.affiliateUrl && res.asin) {
      outputEl.value = res.affiliateUrl;
      if (asinBadge) asinBadge.textContent = `ASIN: ${res.asin}`;
      if (testBtn) testBtn.href = res.affiliateUrl;
      resultBox.classList.remove('hidden');
    } else {
      alert(res.error || 'Invalid Amazon URL or ASIN');
    }
  }

  generateBtn?.addEventListener('click', generateLink);
  inputEl?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      generateLink();
    }
  });

  copyBtn?.addEventListener('click', () => {
    if (outputEl && outputEl.value) {
      navigator.clipboard.writeText(outputEl.value);
      copyBtn.textContent = 'Copied!';
      setTimeout(() => {
        copyBtn.textContent = 'Copy Link';
      }, 2000);
    }
  });
</script>
