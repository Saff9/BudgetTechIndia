---
/**
 * Storage Selector Component
 * UI for selecting and managing storage systems
 * 
 * @component
 * @version 1.0.0
 */

import { getStorageSystem, isFirebaseConfigured, isLocalConfigured } from '../../utils/storage';

interface Props {
  currentStorage?: string;
  onStorageChange?: (type: string) => void;
}

const { currentStorage = 'local', onStorageChange } = Astro.props;

const isFirebaseReady = isFirebaseConfigured();
const isLocalReady = isLocalConfigured();
---

<div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
  <h3 class="text-lg font-semibold text-[#F4F1EA] mb-4">Storage Configuration</h3>
  
  <div class="space-y-4">
    <!-- Current Storage Status -->
    <div class="flex items-center justify-between p-4 bg-[#0F1F24] rounded-lg">
      <div>
        <p class="text-sm text-[#a8b5ba]">Current Storage System</p>
        <p class="text-lg font-medium text-[#F4F1EA]">
          {currentStorage === 'firebase' ? 'Firebase Firestore' : 'Local JSON Files'}
        </p>
      </div>
      <div class={`px-3 py-1 rounded-full text-sm font-medium ${
        currentStorage === 'firebase' ? 'bg-blue-500/20 text-blue-400' : 'bg-green-500/20 text-green-400'
      }`}>
        {currentStorage === 'firebase' ? 'Firebase' : 'Local'}
      </div>
    </div>

    <!-- Storage Options -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Local Storage Option -->
      <label class={`relative p-4 border rounded-lg cursor-pointer transition-all ${
        currentStorage === 'local' 
          ? 'border-[#C46A3A] bg-[#C46A3A]/10' 
          : 'border-[#2a4450] bg-[#0F1F24] hover:border-[#C46A3A]'
      }`}>
        <input
          type="radio"
          name="storageType"
          value="local"
          checked={currentStorage === 'local'}
          disabled={!isLocalReady}
          class="sr-only"
          onChange={(e) => onStorageChange?.(e.target.value)}
        />
        <div class="flex items-center gap-4">
          <div class={`w-12 h-12 rounded-lg flex items-center justify-center ${
            currentStorage === 'local' ? 'bg-[#C46A3A] text-white' : 'bg-[#2a4450] text-[#a8b5ba]'
          }`}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <div class="flex-1">
            <h4 class="font-medium text-[#F4F1EA]">Local JSON Files</h4>
            <p class="text-sm text-[#a8b5ba]">
              File-based storage with no external dependencies
            </p>
            <div class="mt-2 flex items-center gap-2">
              <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-full text-xs font-medium">
                Available
              </span>
            </div>
          </div>
          {currentStorage === 'local' && (
            <div class="w-4 h-4 rounded-full bg-[#C46A3A] flex items-center justify-center">
              <svg class="w-2 h-2 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
            </div>
          )}
        </div>
      </label>

      <!-- Firebase Storage Option -->
      <label class={`relative p-4 border rounded-lg cursor-pointer transition-all ${
        currentStorage === 'firebase' 
          ? 'border-[#C46A3A] bg-[#C46A3A]/10' 
          : 'border-[#2a4450] bg-[#0F1F24] hover:border-[#C46A3A]'
      }`}>
        <input
          type="radio"
          name="storageType"
          value="firebase"
          checked={currentStorage === 'firebase'}
          disabled={!isFirebaseReady}
          class="sr-only"
          onChange={(e) => onStorageChange?.(e.target.value)}
        />
        <div class="flex items-center gap-4">
          <div class={`w-12 h-12 rounded-lg flex items-center justify-center ${
            currentStorage === 'firebase' ? 'bg-[#C46A3A] text-white' : 'bg-[#2a4450] text-[#a8b5ba]'
          }`}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="flex-1">
            <h4 class="font-medium text-[#F4F1EA]">Firebase Firestore</h4>
            <p class="text-sm text-[#a8b5ba]">
              Cloud-based NoSQL database with real-time synchronization
            </p>
            <div class="mt-2 flex items-center gap-2">
              {isFirebaseReady ? (
                <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-full text-xs font-medium">
                  Configured
                </span>
              ) : (
                <span class="px-2 py-1 bg-yellow-500/20 text-yellow-400 rounded-full text-xs font-medium">
                  Not Configured
                </span>
              )}
            </div>
          </div>
          {currentStorage === 'firebase' && (
            <div class="w-4 h-4 rounded-full bg-[#C46A3A] flex items-center justify-center">
              <svg class="w-2 h-2 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
              </svg>
            </div>
          )}
        </div>
      </label>
    </div>

    <!-- Storage Information -->
    <div class="mt-6 p-4 bg-[#0F1F24] rounded-lg">
      <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Storage System Information</h4>
      {currentStorage === 'local' ? (
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <p>• Files stored in <code class="bg-[#2a4450] px-1 py-0.5 rounded">src/data/</code> directory</p>
          <p>• Products: <code class="bg-[#2a4450] px-1 py-0.5 rounded">products.json</code></p>
          <p>• Categories: <code class="bg-[#2a4450] px-1 py-0.5 rounded">categories.json</code></p>
          <p>• Content: <code class="bg-[#2a4450] px-1 py-0.5 rounded">content.json</code></p>
          <p>• Settings: <code class="bg-[#2a4450] px-1 py-0.5 rounded">settings.json</code></p>
        </div>
      ) : (
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <p>• Data stored in Firebase Firestore database</p>
          <p>• Real-time synchronization across devices</p>
          <p>• Automatic backup and redundancy</p>
          <p>• Project ID: {import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || 'Not configured'}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Configuration Instructions -->
  {!isFirebaseReady && (
    <div class="mt-6 p-4 bg-yellow-500/10 border border-yellow-500/20 rounded-lg">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-yellow-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div class="flex-1">
          <h4 class="text-sm font-medium text-yellow-400 mb-1">Firebase Configuration Required</h4>
          <p class="text-sm text-yellow-300">
            To use Firebase storage, you need to configure the Firebase credentials in 
            the <code class="bg-yellow-500/20 px-1 py-0.5 rounded">.env</code> file.
          </p>
        </div>
      </div>
    </div>
  )}
</div>
