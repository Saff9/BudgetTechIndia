---
/**
 * Data Migration Component
 * Tool for migrating data between storage systems
 * 
 * @component
 * @version 1.0.0
 */

import { getStorageSystem } from '../../utils/storage';

interface Props {
  currentStorage?: string;
}

const { currentStorage = 'local' } = Astro.props;

const targetStorage = currentStorage === 'firebase' ? 'local' : 'firebase';
---

<div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
  <h3 class="text-lg font-semibold text-[#F4F1EA] mb-4">Data Migration</h3>
  
  <div class="space-y-4">
    <!-- Migration Options -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Export Data -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">
          <svg class="w-4 h-4 inline mr-2 text-[#4a90c2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Export Data
        </h4>
        <p class="text-sm text-[#a8b5ba] mb-3">
          Export all data from current storage system to JSON file.
        </p>
        <button
          type="button"
          class="px-3 py-2 text-sm text-[#F4F1EA] bg-[#4a90c2]/20 text-[#4a90c2] rounded-lg hover:bg-[#4a90c2]/30 transition-colors"
          onClick={async () => {
            const storage = await getStorageSystem(currentStorage);
            const data = await storage.exportData();
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `budgettechindia-data-${new Date().toISOString().split('T')[0]}.json`;
            a.click();
            URL.revokeObjectURL(url);
          }}
        >
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Export to JSON
        </button>
      </div>

      <!-- Import Data -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">
          <svg class="w-4 h-4 inline mr-2 text-[#4a90c2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Import Data
        </h4>
        <p class="text-sm text-[#a8b5ba] mb-3">
          Import data from JSON file into current storage system.
        </p>
        <label class="inline-flex items-center gap-2 px-3 py-2 text-sm text-[#F4F1EA] bg-[#4a90c2]/20 text-[#4a90c2] rounded-lg hover:bg-[#4a90c2]/30 transition-colors cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
          </svg>
          Import from JSON
          <input
            type="file"
            accept=".json"
            class="hidden"
            onChange={async (e) => {
              const file = e.target.files?.[0];
              if (file) {
                const reader = new FileReader();
                reader.onload = async (e) => {
                  try {
                    const data = e.target?.result as string;
                    const storage = await getStorageSystem(currentStorage);
                    const success = await storage.importData(data);
                    
                    if (success) {
                      alert('Data imported successfully!');
                      window.location.reload();
                    } else {
                      alert('Failed to import data.');
                    }
                  } catch (error) {
                    console.error('Import error:', error);
                    alert('Error importing data. Please check the console for details.');
                  }
                };
                reader.readAsText(file);
              }
            }}
          />
        </label>
      </div>
    </div>

    <!-- Migration between storage systems -->
    <div class="p-4 bg-[#0F1F24] rounded-lg">
      <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">
        <svg class="w-4 h-4 inline mr-2 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        Migrate Data
      </h4>
      <p class="text-sm text-[#a8b5ba] mb-3">
        Migrate all data from <strong>{currentStorage === 'firebase' ? 'Firebase Firestore' : 'Local JSON Files'}</strong> 
        to <strong>{targetStorage === 'firebase' ? 'Firebase Firestore' : 'Local JSON Files'}</strong>.
      </p>
      <button
        type="button"
        class="px-3 py-2 text-sm text-[#F4F1EA] bg-[#C46A3A] rounded-lg hover:bg-[#d4834f] transition-colors"
        onClick={async () => {
          if (!confirm('Are you sure you want to migrate all data? This will overwrite existing data in the target storage system.')) {
            return;
          }

          try {
            // Get current storage system and export data
            const sourceStorage = await getStorageSystem(currentStorage);
            const data = await sourceStorage.exportData();

            // Import data into target storage system
            const targetStorageSystem = await getStorageSystem(targetStorage);
            const success = await targetStorageSystem.importData(data);

            if (success) {
              alert('Data migrated successfully!');
              window.location.reload();
            } else {
              alert('Failed to migrate data.');
            }
          } catch (error) {
            console.error('Migration error:', error);
            alert('Error migrating data. Please check the console for details.');
          }
        }}
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        Migrate to {targetStorage === 'firebase' ? 'Firebase' : 'Local Storage'}
      </button>
    </div>

    <!-- Batch Operations -->
    <div class="p-4 bg-[#0F1F24] rounded-lg">
      <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">
        <svg class="w-4 h-4 inline mr-2 text-[#00b207]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        Batch Operations
      </h4>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class="px-3 py-2 text-sm text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors"
        >
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Batch Delete
        </button>
        <button
          type="button"
          class="px-3 py-2 text-sm text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors"
        >
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          Duplicate Selected
        </button>
        <button
          type="button"
          class="px-3 py-2 text-sm text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors"
        >
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          Update Prices
        </button>
      </div>
    </div>
  </div>

  <!-- Warning Note -->
  <div class="mt-6 p-4 bg-yellow-500/10 border border-yellow-500/20 rounded-lg">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-yellow-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div class="flex-1">
        <h4 class="text-sm font-medium text-yellow-400 mb-1">Important Note</h4>
        <p class="text-sm text-yellow-300">
          Data migration operations are irreversible. Please make sure to export a backup before performing any migration
          or batch operations.
        </p>
      </div>
    </div>
  </div>
</div>
