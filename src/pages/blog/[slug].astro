---
/**
 * Blog Article Page for BudgetTechIndia
 * General blog posts with author info and related articles
 */

import type { Article, BreadcrumbItem, Author } from '../../utils/interfaces';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import AffiliateDisclosure from '../../components/common/AffiliateDisclosure.astro';
import JsonLD from '../../components/seo/JsonLD.astro';
import { formatDate } from '../../utils/helpers';

// Define static paths for all blog articles
export async function getStaticPaths() {
  const articlesData = await import('../../data/articles.json');
  const blogArticles = articlesData.default.articles.filter(
    (a: Article) => a.type === 'blog'
  );
  return blogArticles.map((article: Article) => ({
    params: { slug: article.slug },
  }));
}

// Get all articles
const articlesData = await import('../../data/articles.json');

// Get slug from URL
const { slug } = Astro.params;

// Find the blog article
const article = articlesData.default.articles.find(
  (a: Article) => a.slug === slug && a.type === 'blog'
);

if (!article) {
  return Astro.redirect('/404');
}

// Get related articles (same category or similar tags)
const relatedArticles: Article[] = articlesData.default.articles
  .filter((a: Article) => a.slug !== slug && (a.category === article.category || a.tags?.some((t: string) => article.tags?.includes(t))))
  .slice(0, 3);

// Breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: article.title },
];

// Author data
const author: Author = {
  id: '1',
  name: article.author,
  bio: 'Tech enthusiast and writer with a passion for helping people find the best budget gadgets. Over 5 years of experience in tech journalism and product reviews.',
  avatar: 'https://placehold.co/100x100/3B82F6/FFFFFF?text=Author',
  role: 'Tech Writer',
  social: {
    twitter: 'https://twitter.com/budgettechin',
    linkedin: 'https://linkedin.com/company/budgettechindia',
  },
};

const siteUrl = import.meta.env.SITE_URL || 'https://budgettechindia.com';

// Table of contents (would be generated from content in real implementation)
const tocItems = [
  { id: 'introduction', text: 'Introduction', level: 2 },
  { id: 'main-content', text: 'Main Content', level: 2 },
  { id: 'key-points', text: 'Key Points', level: 2 },
  { id: 'conclusion', text: 'Conclusion', level: 2 },
];

// Article schema data for JSON-LD (matching JsonLD component's expected structure)
const articleSchemaData = {
  article: {
    title: article.title,
    description: article.excerpt,
    pubDate: article.date,
    updatedDate: article.updatedDate,
  },
  url: `${siteUrl}/blog/${article.slug}`,
  imageUrl: article.imageUrl.startsWith('http') ? article.imageUrl : `${siteUrl}${article.imageUrl}`,
  authorName: author.name,
};

// Social share URLs
const shareUrls = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(article.title)}&url=${encodeURIComponent(`${siteUrl}/blog/${article.slug}`)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`${siteUrl}/blog/${article.slug}`)}`,
  linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`${siteUrl}/blog/${article.slug}`)}&title=${encodeURIComponent(article.title)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${article.title} ${siteUrl}/blog/${article.slug}`)}`,
};
---

<BaseLayout
  title={`${article.title} | BudgetTechIndia`}
  description={article.excerpt}
  image={article.imageUrl}
  type="article"
  currentPath={`/blog/${slug}`}
  publishedTime={new Date(article.date)}
  author={article.author}
>
  <!-- Article Schema -->
  <JsonLD type="article" data={articleSchemaData} />

  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs} />

    <div class="grid lg:grid-cols-[1fr_300px] gap-8">
      <!-- Main Content -->
      <article class="max-w-3xl">
        <!-- Header -->
        <header class="mb-8">
          <!-- Category Badge -->
          {article.category && (
            <a
              href={`/categories/${article.category}`}
              class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-medium rounded-full mb-4 hover:bg-primary-200 transition-colors"
            >
              {article.category.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase())}
            </a>
          )}

          <!-- Title -->
          <h1 class="font-heading text-h1 text-neutral-900 mb-4">
            {article.title}
          </h1>

          <!-- Meta -->
          <div class="flex flex-wrap items-center gap-4 text-sm text-neutral-500 mb-6">
            <time datetime={new Date(article.date).toISOString()}>
              {formatDate(new Date(article.date))}
            </time>
            <span>By {article.author}</span>
            <span>{article.readTime || '5 min read'}</span>
          </div>

          <!-- Featured Image -->
          <img
            src={article.imageUrl}
            alt={article.title}
            class="w-full aspect-video object-cover rounded-xl shadow-soft"
            loading="eager"
          />
        </header>

        <!-- Affiliate Disclosure (if article has affiliate links) -->
        <div class="mb-8">
          <AffiliateDisclosure variant="inline" />
        </div>

        <!-- Article Content -->
        <div class="prose prose-lg max-w-none mb-10" id="main-content">
          <!-- Introduction -->
          <h2 id="introduction">Introduction</h2>
          <p>
            {article.excerpt}
          </p>
          <p>
            In this article, we'll explore everything you need to know about this topic. Whether you're a beginner or an experienced tech enthusiast, you'll find valuable insights and practical tips to help you make informed decisions.
          </p>

          <!-- Main Content Section -->
          <h2 id="key-points">Key Points to Consider</h2>
          <p>
            When it comes to budget tech products, there are several important factors to consider. Understanding these will help you get the best value for your money without compromising on quality.
          </p>

          <h3>Quality vs Price</h3>
          <p>
            One of the biggest challenges when shopping for budget tech products is balancing quality with price. While it's tempting to go for the cheapest option, this often leads to disappointment. Instead, look for products that offer the best value - a combination of reasonable price and good quality.
          </p>

          <h3>Brand Reputation</h3>
          <p>
            In the budget segment, brand reputation matters more than ever. Established brands like boAt, Realme, and Xiaomi have built their reputation on delivering quality products at affordable prices. While lesser-known brands might offer similar specs, the after-sales support and build quality often differ significantly.
          </p>

          <h3>Feature Prioritization</h3>
          <p>
            Not all features are equally important. Identify what matters most to you - whether it's battery life, sound quality, or build quality - and prioritize products that excel in those areas. Don't pay for features you won't use.
          </p>

          <h2>Practical Tips</h2>
          <p>
            Here are some practical tips to help you make better purchasing decisions:
          </p>
          <ul>
            <li><strong>Read reviews from multiple sources</strong> - Don't rely on a single review. Check multiple sources including YouTube reviews, blog posts, and user reviews on Amazon.</li>
            <li><strong>Check the warranty</strong> - Budget products should still come with a decent warranty. Look for at least 6 months to 1 year of warranty coverage.</li>
            <li><strong>Compare prices across platforms</strong> - Sometimes the same product is priced differently on different platforms. Always compare before buying.</li>
            <li><strong>Look for seasonal sales</strong> - Diwali, Republic Day, and other major sales events can offer significant discounts on tech products.</li>
          </ul>

          <h2>Common Mistakes to Avoid</h2>
          <p>
            Many buyers make these common mistakes when shopping for budget tech:
          </p>
          <ol>
            <li><strong>Ignoring the specs</strong> - Always check the specifications, even for budget products. A slightly higher price might get you significantly better specs.</li>
            <li><strong>Buying based on looks alone</strong> - A product might look great but perform poorly. Always prioritize function over form.</li>
            <li><strong>Not checking compatibility</strong> - Make sure the product is compatible with your existing devices before purchasing.</li>
            <li><strong>Overlooking after-sales support</strong> - Check if the brand has service centers in your area. Good after-sales support can save you a lot of trouble.</li>
          </ol>

          <!-- Conclusion -->
          <h2 id="conclusion">Conclusion</h2>
          <p>
            Making smart purchasing decisions for budget tech products doesn't have to be complicated. By considering the factors we've discussed and avoiding common mistakes, you can find products that offer excellent value for money.
          </p>
          <p>
            Remember, the goal isn't to find the cheapest product, but to find the best value. Sometimes spending a little more upfront can save you money in the long run by avoiding replacements and repairs.
          </p>
          <p>
            <strong>What's your experience with budget tech products?</strong> Share your thoughts in the comments below or reach out to us on social media!
          </p>
        </div>

        <!-- Tags -->
        {article.tags && article.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-8">
            {article.tags.map((tag: string) => (
              <a
                href={`/blog?tag=${tag}`}
                class="px-3 py-1 bg-neutral-100 text-neutral-600 text-sm rounded-full hover:bg-neutral-200 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Social Share Buttons -->
        <div class="border-t border-b border-neutral-200 py-6 mb-10">
          <h3 class="font-semibold text-neutral-900 mb-4">Share this article</h3>
          <div class="flex flex-wrap gap-3">
            <a
              href={shareUrls.twitter}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#1DA1F2] text-white rounded-lg hover:bg-[#1a8cd8] transition-colors"
              aria-label="Share on Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
              Twitter
            </a>
            <a
              href={shareUrls.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#4267B2] text-white rounded-lg hover:bg-[#375695] transition-colors"
              aria-label="Share on Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook
            </a>
            <a
              href={shareUrls.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#0077B5] text-white rounded-lg hover:bg-[#006097] transition-colors"
              aria-label="Share on LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a
              href={shareUrls.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-[#25D366] text-white rounded-lg hover:bg-[#20bd5a] transition-colors"
              aria-label="Share on WhatsApp"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.173-1.414-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.377l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              WhatsApp
            </a>
          </div>
        </div>

        <!-- Author Box -->
        <div class="bg-neutral-50 rounded-xl p-6 mb-10">
          <div class="flex flex-col sm:flex-row items-start gap-4">
            <img
              src={author.avatar}
              alt={author.name}
              class="w-20 h-20 rounded-full object-cover"
              loading="lazy"
            />
            <div class="flex-1">
              <p class="font-heading font-semibold text-lg text-neutral-900 mb-1">{author.name}</p>
              <p class="text-sm text-neutral-500 mb-2">{author.role}</p>
              <p class="text-sm text-neutral-600 mb-3">{author.bio}</p>
              {author.social && (
                <div class="flex gap-3">
                  {author.social.twitter && (
                    <a
                      href={author.social.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-neutral-400 hover:text-[#1DA1F2] transition-colors"
                      aria-label={`${author.name} on Twitter`}
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                      </svg>
                    </a>
                  )}
                  {author.social.linkedin && (
                    <a
                      href={author.social.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-neutral-400 hover:text-[#0077B5] transition-colors"
                      aria-label={`${author.name} on LinkedIn`}
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="lg:sticky lg:top-24 lg:self-start space-y-8">
        <!-- Table of Contents -->
        <nav class="bg-neutral-50 rounded-xl p-5" aria-labelledby="toc-heading">
          <h2 id="toc-heading" class="font-heading font-semibold text-neutral-900 mb-4">
            Table of Contents
          </h2>
          <ul class="space-y-2 text-sm">
            {tocItems.map((item) => (
              <li class={item.level === 3 ? 'ml-4' : ''}>
                <a
                  href={`#${item.id}`}
                  class="text-neutral-600 hover:text-primary-600 transition-colors duration-200"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <!-- Newsletter Signup -->
        <div class="bg-primary-500 rounded-xl p-5 text-white">
          <h3 class="font-heading font-semibold mb-2">Subscribe to Our Newsletter</h3>
          <p class="text-sm text-primary-100 mb-4">
            Get the latest budget tech reviews and guides delivered to your inbox.
          </p>
          <form class="space-y-3">
            <input
              type="email"
              placeholder="Enter your email"
              class="w-full px-4 py-2 rounded-lg text-neutral-900 text-sm"
              required
            />
            <button
              type="submit"
              class="w-full bg-accent-500 text-white py-2 rounded-lg font-semibold text-sm hover:bg-accent-600 transition-colors"
            >
              Subscribe
            </button>
          </form>
        </div>

        <!-- Related Articles -->
        {relatedArticles.length > 0 && (
          <div class="bg-neutral-50 rounded-xl p-5">
            <h3 class="font-heading font-semibold text-neutral-900 mb-4">
              Related Articles
            </h3>
            <div class="space-y-4">
              {relatedArticles.map((relatedArticle) => (
                <a
                  href={`/blog/${relatedArticle.slug}`}
                  class="flex gap-3 group"
                >
                  <img
                    src={relatedArticle.imageUrl}
                    alt={relatedArticle.title}
                    class="w-20 h-14 object-cover rounded-lg flex-shrink-0"
                    loading="lazy"
                  />
                  <div>
                    <p class="text-sm font-medium text-neutral-900 group-hover:text-primary-600 transition-colors line-clamp-2">
                      {relatedArticle.title}
                    </p>
                    <p class="text-xs text-neutral-500 mt-1">
                      {relatedArticle.readTime || '5 min read'}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- More Related Articles -->
    {relatedArticles.length > 0 && (
      <section class="mt-16 pt-8 border-t border-neutral-200">
        <h2 class="font-heading text-h3 text-neutral-900 mb-6">More Articles You Might Like</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedArticles.map((relatedArticle) => (
            <article class="group">
              <a
                href={`/blog/${relatedArticle.slug}`}
                class="block aspect-video bg-neutral-100 rounded-xl overflow-hidden mb-3"
              >
                <img
                  src={relatedArticle.imageUrl}
                  alt={relatedArticle.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </a>
              {relatedArticle.category && (
                <span class="text-xs text-primary-600 font-medium uppercase tracking-wide">
                  {relatedArticle.category.replace(/-/g, ' ')}
                </span>
              )}
              <h3 class="font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors duration-200 line-clamp-2 mt-1">
                <a href={`/blog/${relatedArticle.slug}`}>
                  {relatedArticle.title}
                </a>
              </h3>
              <p class="text-sm text-neutral-500 mt-2">
                {formatDate(new Date(relatedArticle.date))}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>