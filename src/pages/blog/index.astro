---
/**
 * Blog Index Page for BudgetTechIndia
 * Lists all blog articles with featured post and category filtering
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import type { BreadcrumbItem } from '../../utils/interfaces';

// Import sample data
import articlesData from '../../data/articles.json';
import categoriesData from '../../data/categories.json';

// Get blog articles
const blogArticles = articlesData.articles.filter(
  (article) => article.type === 'blog'
);

// Get all articles for featured post (most recent)
const allArticles = articlesData.articles;
const featuredArticle = allArticles[0];

// Get categories for filter
const categories = categoriesData.categories;

// Breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Blog' },
];
---

<BaseLayout
  title="Tech Blog - Buying Guides, Tips & News | BudgetTechIndia"
  description="Read our tech blog for buying guides, tips, and the latest news about budget tech products in India. Expert advice to help you make smart purchasing decisions."
  currentPath="/blog"
>
  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <header class="mb-8">
      <h1 class="font-heading text-h1 text-neutral-900 mb-4">
        Tech Blog
      </h1>
      <p class="text-neutral-600 max-w-3xl">
        Buying guides, tips, and insights to help you make smart tech purchases. 
        Stay updated with the latest trends in budget tech.
      </p>
    </header>

    <!-- Featured Post -->
    {featuredArticle && (
      <section class="mb-12">
        <div class="bg-gradient-to-br from-primary-50 to-primary-100 rounded-2xl overflow-hidden">
          <div class="md:grid md:grid-cols-2 md:gap-8">
            <div class="aspect-banner md:aspect-auto md:h-full overflow-hidden">
              <img
                src={featuredArticle.imageUrl}
                alt={featuredArticle.title}
                class="w-full h-full object-cover"
                loading="eager"
              />
            </div>
            <div class="p-8 md:p-12 flex flex-col justify-center">
              <div class="flex items-center gap-2 mb-4">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-medium ${
                  featuredArticle.type === 'review' ? 'bg-blue-100 text-blue-700' :
                  featuredArticle.type === 'top5' ? 'bg-purple-100 text-purple-700' :
                  'bg-green-100 text-green-700'
                }`}>
                  {featuredArticle.type === 'review' ? 'Review' : 
                   featuredArticle.type === 'top5' ? 'Top 5' : 'Blog'}
                </span>
                <span class="text-xs text-primary-600 font-medium">Featured</span>
              </div>
              <h2 class="font-heading text-2xl md:text-3xl font-bold text-neutral-900 mb-4">
                <a href={`/blog/${featuredArticle.slug}`} class="hover:text-primary-600 transition-colors duration-200">
                  {featuredArticle.title}
                </a>
              </h2>
              <p class="text-neutral-600 mb-6 line-clamp-3">
                {featuredArticle.excerpt}
              </p>
              <div class="flex items-center gap-4 text-sm text-neutral-500">
                <time datetime={featuredArticle.date}>{featuredArticle.date}</time>
                <span>{featuredArticle.readTime}</span>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {featuredArticle.author}
                </span>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Category Filter -->
    <div class="flex flex-wrap items-center gap-2 mb-8">
      <span class="text-sm text-neutral-500 font-medium">Filter by topic:</span>
      <button
        type="button"
        class="px-3 py-1.5 text-sm font-medium rounded-full bg-primary-500 text-white"
      >
        All Posts
      </button>
      {categories.slice(0, 5).map((category) => (
        <button
          type="button"
          class="px-3 py-1.5 text-sm font-medium rounded-full bg-white text-neutral-700 border border-neutral-300 hover:border-primary-500 hover:text-primary-600 transition-colors duration-200"
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Blog Articles Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {blogArticles.map((article) => (
        <article class="group bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-shadow duration-300">
          <a href={`/blog/${article.slug}`} class="block">
            <!-- Image -->
            <div class="aspect-banner bg-neutral-200 overflow-hidden">
              <img
                src={article.imageUrl}
                alt={article.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <!-- Content -->
            <div class="p-6">
              <!-- Category Badge -->
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">
                  Blog
                </span>
                {article.category && (
                  <span class="text-xs text-neutral-500">
                    {categories.find((c) => c.id === article.category)?.name || article.category}
                  </span>
                )}
              </div>

              <!-- Title -->
              <h2 class="font-heading font-semibold text-lg text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors duration-200 line-clamp-2">
                {article.title}
              </h2>

              <!-- Excerpt -->
              <p class="text-sm text-neutral-600 line-clamp-2 mb-4">
                {article.excerpt}
              </p>

              <!-- Meta -->
              <div class="flex items-center justify-between text-xs text-neutral-500">
                <div class="flex items-center gap-4">
                  <time datetime={article.date}>{article.date}</time>
                  <span>{article.readTime}</span>
                </div>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {article.author}
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Pagination -->
    {blogArticles.length > 9 && (
      <nav class="mt-12 flex justify-center" aria-label="Pagination">
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-500 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Previous
          </button>
          <span class="px-4 py-2 text-sm font-medium text-white bg-primary-500 rounded-lg">
            1
          </span>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            2
          </button>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            Next
          </button>
        </div>
      </nav>
    )}

    <!-- Empty State -->
    {blogArticles.length === 0 && (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h2 class="font-heading text-h4 text-neutral-700 mb-2">No blog posts found</h2>
        <p class="text-neutral-500">Check back soon for new content!</p>
      </div>
    )}

    <!-- Newsletter CTA -->
    <section class="mt-16 bg-gradient-to-br from-green-600 to-green-800 rounded-2xl p-8 md:p-12 text-center text-white">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        Get the Latest Tips in Your Inbox
      </h2>
      <p class="text-green-100 mb-6 max-w-2xl mx-auto">
        Subscribe to our newsletter for weekly buying guides, tips, and exclusive deals on budget tech products.
      </p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <label for="newsletter-email" class="sr-only">Email address</label>
        <input
          type="email"
          id="newsletter-email"
          name="email"
          placeholder="Enter your email"
          required
          class="flex-1 px-4 py-3 rounded-lg border border-transparent focus:ring-2 focus:ring-white focus:border-white text-neutral-900"
        />
        <button type="submit" class="px-6 py-3 bg-white text-green-700 font-semibold rounded-lg hover:bg-green-50 transition-colors duration-200">
          Subscribe
        </button>
      </form>
    </section>
  </div>
</BaseLayout>
