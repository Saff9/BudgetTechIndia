---
/**
 * Admin Dashboard Page for BudgetTechIndia
 * Overview of admin panel with storage status
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import type { Product, Category } from '../../utils/interfaces';
import AmazonLinkGenerator from '../../components/admin/AmazonLinkGenerator.astro';
import GrokAiGenerator from '../../components/admin/GrokAiGenerator.astro';
import productsData from '../../data/products.json';
import categoriesData from '../../data/categories.json';
import { getStorageSystem } from '../../utils/storage';

const totalProducts = productsData.products.length;
const totalCategories = categoriesData.categories.length;
const activeProducts = productsData.products.filter((p) => p.isActive).length;
const inactiveProducts = totalProducts - activeProducts;

// Get storage system information
const storageSystem = await getStorageSystem();
const storageInfo = storageSystem.getStorageInfo();
---

<AdminLayout title="Dashboard - Admin Panel">
  <!-- Grok AI Review Generator -->
  <GrokAiGenerator />
  <!-- Amazon Link Generator Tool -->
  <AmazonLinkGenerator />
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Storage Status -->
    <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-[#a8b5ba] mb-1">Storage System</p>
          <p class="text-lg font-bold text-[#F4F1EA] truncate">{storageInfo.name}</p>
        </div>
        <div class={`w-12 h-12 rounded-lg flex items-center justify-center ${
          storageInfo.isConfigured 
            ? 'bg-green-500/20 text-green-400' 
            : 'bg-yellow-500/20 text-yellow-400'
        }`}>
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            {storageInfo.type === 'firebase' ? (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            ) : (
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            )}
          </svg>
        </div>
      </div>
      <div class="mt-2 text-xs text-[#a8b5ba]">
        {storageInfo.description}
      </div>
    </div>

    <!-- Total Products -->
    <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-[#a8b5ba] mb-1">Total Products</p>
          <p class="text-2xl font-bold text-[#F4F1EA]">{totalProducts}</p>
        </div>
        <div class="w-12 h-12 bg-[#C46A3A]/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Active Products -->
    <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-[#a8b5ba] mb-1">Active Products</p>
          <p class="text-2xl font-bold text-[#F4F1EA]">{activeProducts}</p>
        </div>
        <div class="w-12 h-12 bg-[#00b207]/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-[#00b207]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Inactive Products -->
    <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-[#a8b5ba] mb-1">Inactive Products</p>
          <p class="text-2xl font-bold text-[#F4F1EA]">{inactiveProducts}</p>
        </div>
        <div class="w-12 h-12 bg-[#df0000]/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-[#df0000]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Total Categories -->
    <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm text-[#a8b5ba] mb-1">Total Categories</p>
          <p class="text-2xl font-bold text-[#F4F1EA]">{totalCategories}</p>
        </div>
        <div class="w-12 h-12 bg-[#4a90c2]/20 rounded-lg flex items-center justify-center">
          <svg class="w-6 h-6 text-[#4a90c2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Products -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50 mb-8">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-[#F4F1EA]">Recent Products</h2>
      <a href="/admin/products" class="text-sm text-[#C46A3A] hover:text-[#d4834f] transition-colors duration-200">
        View All
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-[#2a4450]">
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Product</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Category</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Price</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Status</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Actions</th>
          </tr>
        </thead>
        <tbody>
          {productsData.products.slice(-5).map((product) => (
            <tr class="border-b border-[#2a4450]/50">
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  <img
                    src={product.imageUrl}
                    alt={product.name}
                    class="w-12 h-12 rounded-lg object-contain"
                    loading="lazy"
                  />
                  <div>
                    <p class="text-sm font-medium text-[#F4F1EA]">{product.name}</p>
                    <p class="text-xs text-[#a8b5ba]">{product.brand}</p>
                  </div>
                </div>
              </td>
              <td class="py-4 px-4 text-sm text-[#a8b5ba]">
                {product.category}
              </td>
              <td class="py-4 px-4 text-sm text-[#F4F1EA]">
                ₹{product.price.toLocaleString('en-IN')}
              </td>
              <td class="py-4 px-4">
                <span class={`px-2 py-1 rounded-full text-xs font-medium ${
                  product.isActive
                    ? 'bg-[#00b207]/20 text-[#00b207]'
                    : 'bg-[#df0000]/20 text-[#df0000]'
                }`}>
                  {product.isActive ? 'Active' : 'Inactive'}
                </span>
              </td>
              <td class="py-4 px-4">
                <div class="flex items-center gap-2">
                  <a
                    href={`/admin/products/edit/${product.id}`}
                    class="px-3 py-1 text-xs font-medium text-[#F4F1EA] bg-[#4a90c2]/20 text-[#4a90c2] rounded-lg hover:bg-[#4a90c2]/30 transition-colors duration-200"
                  >
                    Edit
                  </a>
                  <button
                    type="button"
                    class="px-3 py-1 text-xs font-medium text-[#F4F1EA] bg-[#df0000]/20 text-[#df0000] rounded-lg hover:bg-[#df0000]/30 transition-colors duration-200"
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
    <h2 class="text-lg font-semibold text-[#F4F1EA] mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/admin/products/add"
        class="flex items-center gap-3 px-6 py-4 bg-[#C46A3A]/20 border border-[#C46A3A]/30 rounded-lg hover:bg-[#C46A3A]/30 transition-colors duration-200"
      >
        <div class="w-10 h-10 bg-[#C46A3A]/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-[#F4F1EA]">Add New Product</p>
          <p class="text-xs text-[#a8b5ba]">Add a new product to the database</p>
        </div>
      </a>

      <a
        href="/admin/categories/add"
        class="flex items-center gap-3 px-6 py-4 bg-[#C46A3A]/20 border border-[#C46A3A]/30 rounded-lg hover:bg-[#C46A3A]/30 transition-colors duration-200"
      >
        <div class="w-10 h-10 bg-[#C46A3A]/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-[#F4F1EA]">Add New Category</p>
          <p class="text-xs text-[#a8b5ba]">Create a new product category</p>
        </div>
      </a>

      <a
        href="/admin/settings"
        class="flex items-center gap-3 px-6 py-4 bg-[#4a90c2]/20 border border-[#4a90c2]/30 rounded-lg hover:bg-[#4a90c2]/30 transition-colors duration-200"
      >
        <div class="w-10 h-10 bg-[#4a90c2]/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-[#4a90c2]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-[#F4F1EA]">Storage Settings</p>
          <p class="text-xs text-[#a8b5ba]">Manage storage configuration and migration</p>
        </div>
      </a>

      <a
        href="/admin/products"
        class="flex items-center gap-3 px-6 py-4 bg-[#00b207]/20 border border-[#00b207]/30 rounded-lg hover:bg-[#00b207]/30 transition-colors duration-200"
      >
        <div class="w-10 h-10 bg-[#00b207]/20 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-[#00b207]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <div>
          <p class="text-sm font-medium text-[#F4F1EA]">Products Management</p>
          <p class="text-xs text-[#a8b5ba]">View and manage all products</p>
        </div>
      </a>
    </div>
  </div>
</AdminLayout>
