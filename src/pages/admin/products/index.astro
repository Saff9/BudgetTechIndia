---
/**
 * Admin Products Page for BudgetTechIndia
 * Manage products in the database with dual storage support
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Product } from '../../../utils/interfaces';
import productsData from '../../../data/products.json';
import { getStorageSystem } from '../../../utils/storage';

// Get storage system
const storageSystem = await getStorageSystem();
const storageInfo = storageSystem.getStorageInfo();

// Get products from configured storage system
let products: Product[];
try {
  products = await storageSystem.getAllProducts();
  if (products.length === 0) {
    products = productsData.products; // Fallback to JSON file if empty
  }
} catch (error) {
  console.error('[Admin Products] Error loading products:', error);
  products = productsData.products;
}

// Sort products
const sortBy = 'newest'; // Default sort: newest first
const sortedProducts = [...products].sort((a, b) => {
  if (sortBy === 'name') {
    return a.name.localeCompare(b.name);
  } else if (sortBy === 'price') {
    return a.price - b.price;
  } else if (sortBy === 'rating') {
    return b.rating - a.rating;
  } else if (sortBy === 'newest') {
    return new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime();
  }
  return 0;
});
---

<AdminLayout title="Products - Admin Panel">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h2 class="text-xl font-bold text-[#F4F1EA]">Products</h2>
      <p class="text-sm text-[#a8b5ba] mt-1">
        Storage: <span class="text-[#C46A3A]">{storageInfo.name}</span>
      </p>
    </div>
    <div class="flex items-center gap-4">
      <a
        href="/admin/settings"
        class="px-4 py-2 text-sm font-medium text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        Storage Settings
      </a>
      <a
        href="/admin/products/add"
        class="px-4 py-2 text-sm font-medium text-[#F4F1EA] bg-[#C46A3A] rounded-lg hover:bg-[#d4834f] transition-colors duration-200"
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
        </svg>
        Add Product
      </a>
    </div>
  </div>

  <!-- Search and Filter -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div class="relative flex-1 max-w-md">
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-[#a8b5ba]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          placeholder="Search products..."
          class="w-full pl-10 pr-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
        />
      </div>

      <div class="flex items-center gap-3">
        <select
          class="px-3 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
        >
          <option value="">All Categories</option>
          <option value="bluetooth-earbuds">Bluetooth Earbuds</option>
          <option value="power-banks">Power Banks</option>
          <option value="smartwatches">Smartwatches</option>
          <option value="laptop-accessories">Laptop Accessories</option>
          <option value="fast-chargers-cables">Fast Chargers & Cables</option>
          <option value="budget-gadgets-under-999">Budget Gadgets Under ₹999</option>
          <option value="work-from-home-essentials">Work From Home Essentials</option>
        </select>

        <select
          class="px-3 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
        >
          <option value="newest">Sort by Newest</option>
          <option value="name">Sort by Name</option>
          <option value="price">Sort by Price</option>
          <option value="rating">Sort by Rating</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Products Table -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="border-b border-[#2a4450]">
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Product</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Category</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Price</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Rating</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Status</th>
            <th class="text-left py-3 px-4 text-sm font-medium text-[#a8b5ba]">Actions</th>
          </tr>
        </thead>
        <tbody>
          {sortedProducts.map((product) => (
            <tr class="border-b border-[#2a4450]/50">
              <td class="py-4 px-4">
                <div class="flex items-center gap-3">
                  <img
                    src={product.imageUrl}
                    alt={product.name}
                    class="w-12 h-12 rounded-lg object-contain"
                    loading="lazy"
                  />
                  <div>
                    <p class="text-sm font-medium text-[#F4F1EA]">{product.name}</p>
                    <p class="text-xs text-[#a8b5ba]">{product.brand}</p>
                  </div>
                </div>
              </td>
              <td class="py-4 px-4 text-sm text-[#a8b5ba]">
                {product.category}
              </td>
              <td class="py-4 px-4 text-sm text-[#F4F1EA]">
                ₹{product.price.toLocaleString('en-IN')}
              </td>
              <td class="py-4 px-4 text-sm text-[#a8b5ba]">
                {product.rating.toFixed(1)} ({product.reviewCount} reviews)
              </td>
              <td class="py-4 px-4">
                <span class={`px-2 py-1 rounded-full text-xs font-medium ${
                  product.isActive
                    ? 'bg-[#00b207]/20 text-[#00b207]'
                    : 'bg-[#df0000]/20 text-[#df0000]'
                }`}>
                  {product.isActive ? 'Active' : 'Inactive'}
                </span>
              </td>
              <td class="py-4 px-4">
                <div class="flex items-center gap-2">
                  <a
                    href={`/admin/products/edit/${product.id}`}
                    class="px-3 py-1 text-xs font-medium text-[#F4F1EA] bg-[#4a90c2]/20 text-[#4a90c2] rounded-lg hover:bg-[#4a90c2]/30 transition-colors duration-200"
                  >
                    Edit
                  </a>
                  <button
                    type="button"
                    class="px-3 py-1 text-xs font-medium text-[#F4F1EA] bg-[#df0000]/20 text-[#df0000] rounded-lg hover:bg-[#df0000]/30 transition-colors duration-200"
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between mt-6">
      <p class="text-sm text-[#a8b5ba]">
        Showing {sortedProducts.length} products
      </p>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="px-3 py-1 text-xs font-medium text-[#a8b5ba] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
          disabled
        >
          Previous
        </button>
        <button
          type="button"
          class="px-3 py-1 text-xs font-medium text-[#F4F1EA] bg-[#C46A3A] rounded-lg hover:bg-[#d4834f] transition-colors duration-200"
        >
          1
        </button>
        <button
          type="button"
          class="px-3 py-1 text-xs font-medium text-[#a8b5ba] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
        >
          Next
        </button>
      </div>
    </div>
  </div>
</AdminLayout>
