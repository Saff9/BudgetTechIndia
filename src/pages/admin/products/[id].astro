---
/**
 * Admin Edit Product Page for BudgetTechIndia
 * Edit an existing product in the database with enhanced form
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Product } from '../../../utils/interfaces';
import productsData from '../../../data/products.json';
import ProductForm from '../../../components/admin/ProductForm.astro';
import { getStorageSystem } from '../../../utils/storage';

// Dynamic route handler
export function getStaticPaths() {
  return productsData.products.map((product) => ({
    params: { id: product.id },
  }));
}

// Get product ID from params
const { id } = Astro.params;

// Find product from JSON file (fallback for static generation)
const product = productsData.products.find((p) => p.id === id);

if (!product) {
  return Astro.redirect('/admin/products');
}

// Get storage system and categories
const storageSystem = await getStorageSystem();
const categories = await storageSystem.getAllCategories();
---

<AdminLayout title="Edit Product - Admin Panel">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-xl font-bold text-[#F4F1EA]">Edit Product</h2>
    <a
      href="/admin/products"
      class="px-4 py-2 text-sm font-medium text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
    >
      <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Products
    </a>
  </div>

  <ProductForm product={product} categories={categories} isEditing={true} />
</AdminLayout>
