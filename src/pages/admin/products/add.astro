---
/**
 * Admin Add Product Page for BudgetTechIndia
 * Add a new product to the database with enhanced form
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Product } from '../../../utils/interfaces';
import ProductForm from '../../../components/admin/ProductForm.astro';
import { getStorageSystem } from '../../../utils/storage';

// Get storage system
const storageSystem = await getStorageSystem();
const categories = await storageSystem.getAllCategories();
---

<AdminLayout title="Add Product - Admin Panel">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-xl font-bold text-[#F4F1EA]">Add New Product</h2>
    <a
      href="/admin/products"
      class="px-4 py-2 text-sm font-medium text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
    >
      <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Products
    </a>
  </div>

  <ProductForm categories={categories} isEditing={false} />
</AdminLayout>
