---
/**
 * Admin Add Product Page for BudgetTechIndia
 * Add a new product to the database with enhanced form
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import type { Product } from '../../../utils/interfaces';
import ProductForm from '../../../components/admin/ProductForm.astro';
import { getStorageSystem } from '../../../utils/storage';

// Get storage system
const storageSystem = await getStorageSystem();
const categories = await storageSystem.getAllCategories();
---

<AdminLayout title="Add Product - Admin Panel">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-xl font-bold text-[#F4F1EA]">Add New Product</h2>
    <a
      href="/admin/products"
      class="px-4 py-2 text-sm font-medium text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
    >
      <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to Products
    </a>
  </div>

  <!-- Product Form -->
  <ProductForm categories={categories} isEditing={false} />
      <!-- Basic Information -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Product Name <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter product name"
          />
        </div>

        <div>
          <label for="brand" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Brand <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="text"
            id="brand"
            name="brand"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter brand name"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="category" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Category <span class="text-[#df0000]">*</span>
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
          >
            <option value="">Select a category</option>
            <option value="bluetooth-earbuds">Bluetooth Earbuds</option>
            <option value="power-banks">Power Banks</option>
            <option value="smartwatches">Smartwatches</option>
            <option value="laptop-accessories">Laptop Accessories</option>
            <option value="fast-chargers-cables">Fast Chargers & Cables</option>
            <option value="budget-gadgets-under-999">Budget Gadgets Under ₹999</option>
            <option value="work-from-home-essentials">Work From Home Essentials</option>
          </select>
        </div>

        <div>
          <label for="price" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Price (₹) <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="number"
            id="price"
            name="price"
            required
            min="0"
            step="0.01"
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter price"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="mrp" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            MRP (₹)
          </label>
          <input
            type="number"
            id="mrp"
            name="mrp"
            min="0"
            step="0.01"
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter MRP"
          />
        </div>

        <div>
          <label for="rating" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Rating
          </label>
          <input
            type="number"
            id="rating"
            name="rating"
            min="0"
            max="5"
            step="0.1"
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter rating (0-5)"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="reviewCount" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Review Count
          </label>
          <input
            type="number"
            id="reviewCount"
            name="reviewCount"
            min="0"
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter review count"
          />
        </div>

        <div>
          <label for="imageUrl" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Image URL <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="url"
            id="imageUrl"
            name="imageUrl"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter image URL"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="affiliateUrl" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Affiliate URL <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="url"
            id="affiliateUrl"
            name="affiliateUrl"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter affiliate URL"
          />
        </div>

        <div>
          <label for="slug" class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Slug <span class="text-[#df0000]">*</span>
          </label>
          <input
            type="text"
            id="slug"
            name="slug"
            required
            class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            placeholder="Enter product slug"
          />
        </div>
      </div>

      <!-- Features -->
      <div>
        <label class="block text-sm font-medium text-[#F4F1EA] mb-2">
          Features
        </label>
        <div class="space-y-3">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input
              type="text"
              placeholder="Feature 1"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
            <input
              type="text"
              placeholder="Feature 2"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <input
              type="text"
              placeholder="Feature 3"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
            <input
              type="text"
              placeholder="Feature 4"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
          </div>
        </div>
      </div>

      <!-- Pros and Cons -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Pros
          </label>
          <div class="space-y-2">
            <input
              type="text"
              placeholder="Pro 1"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
            <input
              type="text"
              placeholder="Pro 2"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
            <input
              type="text"
              placeholder="Pro 3"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-[#F4F1EA] mb-2">
            Cons
          </label>
          <div class="space-y-2">
            <input
              type="text"
              placeholder="Con 1"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
            <input
              type="text"
              placeholder="Con 2"
              class="w-full px-4 py-2 bg-[#0F1F24] border border-[#2a4450] rounded-lg text-sm text-[#F4F1EA] placeholder-[#a8b5ba] focus:outline-none focus:border-[#C46A3A] focus:ring-1 focus:ring-[#C46A3A]"
            />
          </div>
        </div>
      </div>

      <!-- Status -->
      <div>
        <label class="flex items-center gap-2 text-sm font-medium text-[#F4F1EA]">
          <input
            type="checkbox"
            id="isActive"
            name="isActive"
            checked
            class="w-4 h-4 text-[#C46A3A] bg-[#0F1F24] border-[#2a4450] rounded focus:ring-[#C46A3A]"
          />
          Active Product
        </label>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center gap-4">
        <button
          type="submit"
          class="px-6 py-3 text-sm font-medium text-[#F4F1EA] bg-[#C46A3A] rounded-lg hover:bg-[#d4834f] transition-colors duration-200"
        >
          <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Add Product
        </button>

        <button
          type="button"
          class="px-6 py-3 text-sm font-medium text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors duration-200"
          onClick={() => window.location.href = '/admin/products'}
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
