---
/**
 * Admin Settings Page for BudgetTechIndia
 * Storage configuration and system settings management
 * 
 * @page
 * @version 1.0.0
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import StorageSelector from '../../components/admin/StorageSelector.astro';
import DataMigration from '../../components/admin/DataMigration.astro';
import { getStorageSystem, isFirebaseConfigured, isLocalConfigured } from '../../utils/storage';

// Get current storage system from environment
const currentStorage = import.meta.env.PUBLIC_STORAGE_TYPE || 'local';

// Get storage system information
const storageSystem = await getStorageSystem();
const storageInfo = storageSystem.getStorageInfo();
---

<AdminLayout title="Settings - Admin Panel">
  <div class="flex items-center justify-between mb-8">
    <h2 class="text-xl font-bold text-[#F4F1EA]">Settings</h2>
  </div>

  <!-- Storage Configuration -->
  <div class="mb-8">
    <StorageSelector
      currentStorage={currentStorage}
      onStorageChange={(type) => {
        // This would typically update environment variables or localStorage
        alert(`Storage system switch to ${type} would require configuration update.`);
      }}
    />
  </div>

  <!-- Data Migration -->
  <div class="mb-8">
    <DataMigration currentStorage={currentStorage} />
  </div>

  <!-- System Information -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
    <h3 class="text-lg font-semibold text-[#F4F1EA] mb-4">System Information</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Storage System Info -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Storage System</h4>
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>Type:</span>
            <span class="font-medium">
              {storageInfo.type === 'firebase' ? 'Firebase Firestore' : 'Local JSON Files'}
            </span>
          </div>
          <div class="flex justify-between">
            <span>Status:</span>
            <span class={`font-medium ${
              storageInfo.isConfigured ? 'text-green-400' : 'text-yellow-400'
            }`}>
              {storageInfo.isConfigured ? 'Configured' : 'Not Configured'}
            </span>
          </div>
          {storageInfo.lastSync && (
            <div class="flex justify-between">
              <span>Last Sync:</span>
              <span class="font-medium">
                {new Date(storageInfo.lastSync).toLocaleString()}
              </span>
            </div>
          )}
        </div>
      </div>

      <!-- Environment Info -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Environment</h4>
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>Node.js Version:</span>
            <span class="font-medium">{process.version}</span>
          </div>
          <div class="flex justify-between">
            <span>Environment:</span>
            <span class="font-medium">
              {import.meta.env.DEV ? 'Development' : import.meta.env.PROD ? 'Production' : 'Unknown'}
            </span>
          </div>
          <div class="flex justify-between">
            <span>Build Time:</span>
            <span class="font-medium">{new Date().toLocaleString()}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- System Settings -->
  <div class="bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
    <h3 class="text-lg font-semibold text-[#F4F1EA] mb-4">System Settings</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Admin Settings -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Admin Credentials</h4>
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>Admin Email:</span>
            <span class="font-medium">{import.meta.env.PUBLIC_ADMIN_EMAIL}</span>
          </div>
          <div class="flex justify-between">
            <span>Password:</span>
            <span class="font-medium">••••••••</span>
          </div>
        </div>
        <button
          type="button"
          class="mt-3 px-3 py-2 text-sm text-[#F4F1EA] bg-[#0F1F24] border border-[#2a4450] rounded-lg hover:bg-[#2a4450] transition-colors"
        >
          Change Password
        </button>
      </div>

      <!-- Site Configuration -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Site Configuration</h4>
        <div class="space-y-2 text-sm text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>Site URL:</span>
            <span class="font-medium">{import.meta.env.SITE_URL}</span>
          </div>
          <div class="flex justify-between">
            <span>Amazon Tag:</span>
            <span class="font-medium">{import.meta.env.AMAZON_AFFILIATE_TAG}</span>
          </div>
          <div class="flex justify-between">
            <span>Analytics ID:</span>
            <span class="font-medium">{import.meta.env.ANALYTICS_ID}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Debug Information -->
  <div class="mt-8 bg-[#1A2E35] rounded-xl p-6 border border-[#2a4450]/50">
    <h3 class="text-lg font-semibold text-[#F4F1EA] mb-4">Debug Information</h3>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Environment Variables -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Environment Variables</h4>
        <div class="space-y-1 text-xs text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>PUBLIC_STORAGE_TYPE:</span>
            <span class="font-mono">{import.meta.env.PUBLIC_STORAGE_TYPE || 'local'}</span>
          </div>
          <div class="flex justify-between">
            <span>Firebase Configured:</span>
            <span class="font-mono">{isFirebaseConfigured() ? 'Yes' : 'No'}</span>
          </div>
          <div class="flex justify-between">
            <span>Local Storage Configured:</span>
            <span class="font-mono">{isLocalConfigured() ? 'Yes' : 'No'}</span>
          </div>
        </div>
      </div>

      <!-- Storage Details -->
      <div class="p-4 bg-[#0F1F24] rounded-lg">
        <h4 class="text-sm font-medium text-[#F4F1EA] mb-2">Storage Details</h4>
        <div class="space-y-1 text-xs text-[#a8b5ba]">
          <div class="flex justify-between">
            <span>Storage Name:</span>
            <span class="font-mono">{storageInfo.name}</span>
          </div>
          <div class="flex justify-between">
            <span>Description:</span>
            <span class="font-mono truncate">{storageInfo.description}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Refresh Cache Button -->
    <div class="mt-4 flex items-center gap-4">
      <button
        type="button"
        class="px-4 py-2 text-sm text-[#F4F1EA] bg-[#4a90c2]/20 text-[#4a90c2] rounded-lg hover:bg-[#4a90c2]/30 transition-colors"
        onClick={() => window.location.reload()}
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Refresh Cache
      </button>
      <button
        type="button"
        class="px-4 py-2 text-sm text-[#F4F1EA] bg-[#df0000]/20 text-[#df0000] rounded-lg hover:bg-[#df0000]/30 transition-colors"
        onClick={() => {
          if (confirm('Are you sure you want to clear all cache? This will reload the application.')) {
            localStorage.clear();
            window.location.reload();
          }
        }}
      >
        <svg class="w-4 h-4 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Clear Cache
      </button>
    </div>
  </div>
</AdminLayout>
