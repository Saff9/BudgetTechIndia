---
/**
 * Reviews Index Page for BudgetTechIndia
 * Lists all review articles with filtering and sorting
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import AffiliateDisclosure from '../../components/common/AffiliateDisclosure.astro';
import type { BreadcrumbItem } from '../../utils/interfaces';

// Import sample data
import articlesData from '../../data/articles.json';
import categoriesData from '../../data/categories.json';

// Get review articles
const reviewArticles = articlesData.articles.filter(
  (article) => article.type === 'review'
);

// Get categories for filter
const categories = categoriesData.categories;

// Breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Reviews' },
];

// Sort options
const sortOptions = [
  { value: 'newest', label: 'Newest First' },
  { value: 'oldest', label: 'Oldest First' },
  { value: 'popular', label: 'Most Popular' },
];
---

<BaseLayout
  title="Product Reviews - Honest Tech Reviews Under ₹2,000 | BudgetTechIndia"
  description="Read our in-depth product reviews for budget tech under ₹2,000. Honest analysis of earbuds, smartwatches, power banks, and more with pros, cons, and buying recommendations."
  currentPath="/reviews"
>
  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <header class="mb-8">
      <h1 class="font-heading text-h1 text-neutral-900 mb-4">
        Product Reviews
      </h1>
      <p class="text-neutral-600 max-w-3xl">
        In-depth, honest reviews of budget tech products under ₹2,000. We test each product 
        thoroughly and share both pros and cons to help you make informed buying decisions.
      </p>
    </header>

    <!-- Affiliate Disclosure -->
    <div class="mb-8">
      <AffiliateDisclosure variant="compact" />
    </div>

    <!-- Filter and Sort Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8 p-4 bg-neutral-50 rounded-xl">
      <!-- Category Filter -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm text-neutral-500 font-medium">Filter by:</span>
        <button
          type="button"
          class="px-3 py-1.5 text-sm font-medium rounded-full bg-primary-500 text-white"
        >
          All Reviews
        </button>
        {categories.slice(0, 4).map((category) => (
          <button
            type="button"
            class="px-3 py-1.5 text-sm font-medium rounded-full bg-white text-neutral-700 border border-neutral-300 hover:border-primary-500 hover:text-primary-600 transition-colors duration-200"
          >
            {category.name}
          </button>
        ))}
      </div>

      <!-- Sort Dropdown -->
      <div class="flex items-center gap-2">
        <label for="sort-select" class="text-sm text-neutral-500">Sort by:</label>
        <select
          id="sort-select"
          name="sort"
          class="form-select text-sm border-neutral-300 rounded-lg focus:ring-primary-500 focus:border-primary-500"
        >
          {sortOptions.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reviewArticles.map((article) => (
        <article class="group bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-shadow duration-300">
          <a href={`/reviews/${article.slug}`} class="block">
            <!-- Image -->
            <div class="aspect-banner bg-neutral-200 overflow-hidden">
              <img
                src={article.imageUrl}
                alt={article.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>

            <!-- Content -->
            <div class="p-6">
              <!-- Category Badge -->
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">
                  Review
                </span>
                {article.category && (
                  <span class="text-xs text-neutral-500">
                    {categories.find((c) => c.id === article.category)?.name || article.category}
                  </span>
                )}
              </div>

              <!-- Title -->
              <h2 class="font-heading font-semibold text-lg text-neutral-900 mb-2 group-hover:text-primary-600 transition-colors duration-200 line-clamp-2">
                {article.title}
              </h2>

              <!-- Excerpt -->
              <p class="text-sm text-neutral-600 line-clamp-2 mb-4">
                {article.excerpt}
              </p>

              <!-- Meta -->
              <div class="flex items-center justify-between text-xs text-neutral-500">
                <div class="flex items-center gap-4">
                  <time datetime={article.date}>{article.date}</time>
                  <span>{article.readTime}</span>
                </div>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {article.author}
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Pagination -->
    {reviewArticles.length > 9 && (
      <nav class="mt-12 flex justify-center" aria-label="Pagination">
        <div class="flex items-center gap-2">
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-500 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 disabled:opacity-50 disabled:cursor-not-allowed"
            disabled
          >
            Previous
          </button>
          <span class="px-4 py-2 text-sm font-medium text-white bg-primary-500 rounded-lg">
            1
          </span>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            2
          </button>
          <button
            type="button"
            class="px-4 py-2 text-sm font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50"
          >
            Next
          </button>
        </div>
      </nav>
    )}

    <!-- Empty State -->
    {reviewArticles.length === 0 && (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <h2 class="font-heading text-h4 text-neutral-700 mb-2">No reviews found</h2>
        <p class="text-neutral-500">Check back soon for new reviews!</p>
      </div>
    )}
  </div>
</BaseLayout>
