---
/**
 * Top 5 Lists Index Page for BudgetTechIndia
 * Lists all top 5 articles with category filtering
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import AffiliateDisclosure from '../../components/common/AffiliateDisclosure.astro';
import type { BreadcrumbItem } from '../../utils/interfaces';

// Import sample data
import articlesData from '../../data/articles.json';
import categoriesData from '../../data/categories.json';

// Get top 5 articles
const top5Articles = articlesData.articles.filter(
  (article) => article.type === 'top5'
);

// Get categories for filter
const categories = categoriesData.categories;

// Breadcrumbs
const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Top 5 Lists' },
];
---

<BaseLayout
  title="Top 5 Lists - Best Budget Tech Picks Under ₹2,000 | BudgetTechIndia"
  description="Discover our curated top 5 lists for budget tech products under ₹2,000. Quick comparisons and rankings to help you find the best earbuds, smartwatches, power banks, and more."
  currentPath="/top-5"
>
  <div class="container py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={breadcrumbs} />

    <!-- Page Header -->
    <header class="mb-8">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3-3m0 0l3 3m-3-3v8m0-13a9 9 0 110 18 9 9 0 010-18z" />
          </svg>
        </div>
        <h1 class="font-heading text-h1 text-neutral-900">
          Top 5 Lists
        </h1>
      </div>
      <p class="text-neutral-600 max-w-3xl">
        Short on time? Our top 5 lists help you quickly find the best products in each category. 
        We've done the research so you can make a quick, informed decision.
      </p>
    </header>

    <!-- Affiliate Disclosure -->
    <div class="mb-8">
      <AffiliateDisclosure variant="compact" />
    </div>

    <!-- How We Rank -->
    <div class="bg-purple-50 border border-purple-200 rounded-xl p-6 mb-8">
      <h2 class="font-heading font-semibold text-lg text-purple-900 mb-3">
        How We Rank Products
      </h2>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-purple-800">
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Value for money analysis</span>
        </div>
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>Real-world performance testing</span>
        </div>
        <div class="flex items-start gap-2">
          <svg class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
          <span>User reviews and ratings</span>
        </div>
      </div>
    </div>

    <!-- Category Filter -->
    <div class="flex flex-wrap items-center gap-2 mb-8">
      <span class="text-sm text-neutral-500 font-medium">Filter by category:</span>
      <button
        type="button"
        class="px-3 py-1.5 text-sm font-medium rounded-full bg-purple-500 text-white"
      >
        All Lists
      </button>
      {categories.slice(0, 5).map((category) => (
        <button
          type="button"
          class="px-3 py-1.5 text-sm font-medium rounded-full bg-white text-neutral-700 border border-neutral-300 hover:border-purple-500 hover:text-purple-600 transition-colors duration-200"
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Top 5 Lists Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
      {top5Articles.map((article, index) => (
        <article class="group bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-shadow duration-300 border-l-4 border-purple-500">
          <a href={`/top-5/${article.slug}`} class="block">
            <!-- Image -->
            <div class="aspect-banner bg-neutral-200 overflow-hidden relative">
              <img
                src={article.imageUrl}
                alt={article.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-4 left-4 w-10 h-10 bg-purple-500 text-white rounded-full flex items-center justify-center font-bold text-lg shadow-lg">
                5
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <!-- Category Badge -->
              <div class="flex items-center gap-2 mb-3">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">
                  Top 5 List
                </span>
                {article.category && (
                  <span class="text-xs text-neutral-500">
                    {categories.find((c) => c.id === article.category)?.name || article.category}
                  </span>
                )}
              </div>

              <!-- Title -->
              <h2 class="font-heading font-semibold text-lg text-neutral-900 mb-2 group-hover:text-purple-600 transition-colors duration-200 line-clamp-2">
                {article.title}
              </h2>

              <!-- Excerpt -->
              <p class="text-sm text-neutral-600 line-clamp-2 mb-4">
                {article.excerpt}
              </p>

              <!-- Meta -->
              <div class="flex items-center justify-between text-xs text-neutral-500">
                <div class="flex items-center gap-4">
                  <time datetime={article.date}>{article.date}</time>
                  <span>{article.readTime}</span>
                </div>
                <span class="text-purple-600 font-medium flex items-center gap-1">
                  View List
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    {top5Articles.length === 0 && (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-neutral-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <h2 class="font-heading text-h4 text-neutral-700 mb-2">No top 5 lists found</h2>
        <p class="text-neutral-500">Check back soon for new lists!</p>
      </div>
    )}

    <!-- CTA Section -->
    <div class="mt-16 bg-gradient-to-br from-purple-600 to-purple-800 rounded-2xl p-8 md:p-12 text-center text-white">
      <h2 class="font-heading text-2xl md:text-3xl font-bold mb-4">
        Can't Find What You're Looking For?
      </h2>
      <p class="text-purple-100 mb-6 max-w-2xl mx-auto">
        We're constantly adding new top 5 lists. Let us know what product category you'd like us to cover next!
      </p>
      <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 bg-white text-purple-700 font-semibold rounded-lg hover:bg-purple-50 transition-colors duration-200">
        Request a List
      </a>
    </div>
  </div>
</BaseLayout>
