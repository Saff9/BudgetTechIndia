---
/**
 * Home Page for BudgetTechIndia
 * Premium Dark Theme - Enhanced with testimonials, brand logos, featured deals
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProductCard from '../components/products/ProductCard.astro';
import JsonLD from '../components/seo/JsonLD.astro';
import type { Category, Product, Article } from '../utils/interfaces';

// Import sample data
import categoriesData from '../data/categories.json';
import productsData from '../data/products.json';
import articlesData from '../data/articles.json';

// Get featured categories
const categories: Category[] = categoriesData.categories;

// Get featured products (first 8)
const featuredProducts: Product[] = productsData.products.slice(0, 8);

// Get latest reviews
const latestReviews = articlesData.articles
  .filter((article) => article.type === 'review')
  .slice(0, 3);

// Get top 5 lists
const top5Lists = articlesData.articles
  .filter((article) => article.type === 'top5')
  .slice(0, 3);

// Testimonials data
const testimonials = [
  {
    name: 'Rahul Sharma',
    location: 'Mumbai',
    avatar: 'RS',
    rating: 5,
    text: 'Found the perfect earbuds under ₹1000 thanks to BudgetTechIndia. Their detailed reviews helped me make an informed decision without overspending.',
    product: 'Boat Airdopes 141',
  },
  {
    name: 'Priya Patel',
    location: 'Delhi',
    avatar: 'PP',
    rating: 5,
    text: 'The comparison tables are so helpful! I was confused between two smartwatches, and their side-by-side comparison made my choice easy.',
    product: 'Noise ColorFit Pro',
  },
  {
    name: 'Amit Kumar',
    location: 'Bangalore',
    avatar: 'AK',
    rating: 5,
    text: 'Finally, a website that understands budget constraints. Every recommendation is practical and value-for-money. Highly recommended!',
    product: 'Realme Power Bank',
  },
];

  // Brand logos with real-looking SVG designs
  const brands = [
    {
      name: 'boAt',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-current hover:text-[#E31E24] transition-colors duration-300">
        <!-- boAt stylized text -->
        <text x="60" y="28" font-family="Arial Black, Impact, sans-serif" font-size="24" font-style="italic" font-weight="900" text-anchor="middle" fill="currentColor">boAt</text>
      </svg>`
    },
    {
      name: 'realme',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-[#FFC915]">
        <!-- realme logo -->
        <text x="60" y="27" font-family="Arial, sans-serif" font-size="22" font-weight="900" letter-spacing="-0.5" text-anchor="middle" fill="currentColor">realme</text>
      </svg>`
    },
    {
      name: 'Noise',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-current hover:text-[#212121] dark:hover:text-white transition-colors duration-300">
        <!-- Noise logo -->
        <text x="60" y="27" font-family="Arial, sans-serif" font-size="22" font-weight="900" font-style="italic" letter-spacing="1" text-anchor="middle" fill="currentColor">NOISE</text>
      </svg>`
    },
    {
      name: 'OnePlus',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-[#F5010C]">
        <!-- OnePlus box logo -->
        <rect x="15" y="8" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"/>
        <text x="21" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="currentColor">1</text>
        <text x="29" y="23" font-family="Arial, sans-serif" font-size="14" font-weight="bold" fill="currentColor">+</text>
        <text x="44" y="25" font-family="Arial, sans-serif" font-size="14" font-weight="700" fill="currentColor">ONEPLUS</text>
      </svg>`
    },
    {
      name: 'Xiaomi',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-[#FF6900]">
        <!-- Xiaomi/Redmi logo -->
        <rect x="18" y="8" width="24" height="24" rx="6" fill="currentColor"/>
        <path d="M23 16v8h2v-5h2v5h2v-6.5c0-1-.8-1.5-1.5-1.5h-4.5z M31 16v8h2v-8h-2z" fill="#fff"/>
        <text x="48" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="800" fill="currentColor">xiaomi</text>
      </svg>`
    },
    {
      name: 'Boult',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-current hover:text-[#E31E24] transition-colors duration-300">
        <!-- Boult Audio logo -->
        <path d="M18 12l-6 10h5l-2 8 8-12h-5l4-6z" fill="currentColor"/>
        <text x="65" y="25" font-family="Arial Black, sans-serif" font-size="18" font-weight="900" text-anchor="middle" fill="currentColor">BOULT</text>
      </svg>`
    },
    {
      name: 'Fire-Boltt',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-current hover:text-[#F37021] transition-colors duration-300">
        <!-- Fire-Boltt logo -->
        <path d="M22 8c-3 4-4.5 7-1.5 10-2-1.5-3-4-1.5-6-4.5 4-6 9-2 13.5 1-3 2-4.5 5-4.5-1.5 2-1.5 4.5 0 6 4-4.5 4.5-9 1.5-12 2 1.5 4 1.5 5 0-3-4.5-6.5-7-6.5-7z" fill="currentColor"/>
        <text x="70" y="25" font-family="Impact, sans-serif" font-size="16" letter-spacing="0.5" text-anchor="middle" fill="currentColor">FIRE-BOLTT</text>
      </svg>`
    },
    {
      name: 'Ambrane',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-current hover:text-[#00529B] transition-colors duration-300">
        <!-- Ambrane logo -->
        <circle cx="20" cy="20" r="8" fill="none" stroke="currentColor" stroke-width="2.5"/>
        <circle cx="20" cy="20" r="3.5" fill="currentColor"/>
        <text x="65" y="25" font-family="Arial, sans-serif" font-size="15" font-weight="800" letter-spacing="1" text-anchor="middle" fill="currentColor">ambrane</text>
      </svg>`
    },
    {
      name: 'Anker',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full text-[#00A9E0]">
        <!-- Anker logo -->
        <path d="M22 26L14 14h3l6 9.5L29 14h3L24 26h-2z" fill="currentColor"/>
        <text x="70" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="800" letter-spacing="1" text-anchor="middle" fill="currentColor">ANKER</text>
      </svg>`
    },
  ];

// Featured deals with countdown
const featuredDeals = [
  {
    title: 'Flash Sale: Earbuds',
    discount: 'Up to 70% OFF',
    endTime: new Date(Date.now() + 24 * 60 * 60 * 1000), // 24 hours from now
    href: '/categories/bluetooth-earbuds',
    image: '/images/categories/earbuds.jpg',
  },
  {
    title: 'Smartwatch Deals',
    discount: 'Starting ₹999',
    endTime: new Date(Date.now() + 12 * 60 * 60 * 1000), // 12 hours from now
    href: '/categories/smartwatches',
    image: '/images/categories/smartwatches.jpg',
  },
];

// Category icons mapping
const categoryIcons: Record<string, string> = {
  'bluetooth-earbuds': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20a8 8 0 100-16 8 8 0 000 16zM9 12a3 3 0 116 0 3 3 0 01-6 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12v6m6-6v6M6.5 9.5L5 8m12.5 1.5L19 8" /></svg>`,
  'power-banks': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 4v16a2 2 0 01-2 2H10a2 2 0 01-2-2V4a2 2 0 012-2h4a2 2 0 012 2zM12 8v.01M12 12v4" /></svg>`,
  'fast-chargers-cables': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  'smartwatches': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 3h-6a2 2 0 00-2 2v2m10 0V5a2 2 0 00-2-2m-8 16v2a2 2 0 002 2h6a2 2 0 002-2v-2" /></svg>`,
  'laptop-accessories': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  'budget-gadgets-under-999': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  'work-from-home-essentials': `<svg class="w-8 h-8 drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
};

// Website schema for SEO
const websiteSchema = {
  name: 'BudgetTechIndia',
  url: 'https://budgettechindia.com',
  description: 'Your trusted source for honest tech product reviews under ₹2,000 in India.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://budgettechindia.com/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="BudgetTechIndia - Best Budget Tech Products Under ₹2,000"
  description="Discover the best budget tech products under ₹2,000 in India. Honest reviews, top 5 lists, and buying guides for earbuds, smartwatches, power banks, and more."
  currentPath="/"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Senior Engineer Live Telemetry & Quick Filter Bar -->
  <section class="py-4 border-y border-[#2a4450]/80 bg-[#0A1619]/90 backdrop-blur-md sticky top-14 z-30 shadow-2xl">
    <div class="container flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[#a8b5ba]">
      <!-- Live Status indicator -->
      <div class="flex items-center space-x-3">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="font-bold text-[#F4F1EA] tracking-wider uppercase">SYSTEM: ONLINE</span>
        <span class="text-[#2a4450] hidden sm:inline">|</span>
        <span class="hidden sm:inline">STORE TAG: <strong class="text-[#F59E0B] bg-[#1A2E35] px-2 py-0.5 rounded border border-[#F59E0B]/40 font-mono">budgettechpro-21</strong></span>
      </div>

      <!-- Quick Price Filters -->
      <div class="flex items-center space-x-2 overflow-x-auto py-1 no-scrollbar">
        <span class="text-[#a8b5ba] font-bold uppercase tracking-wider text-[11px] mr-1 hidden sm:inline">FILTER:</span>
        <a href="/categories/budget-gadgets-under-999" class="px-3 py-1.5 rounded-lg bg-[#1A2E35] hover:bg-[#F59E0B] text-[#F4F1EA] transition-all border border-[#2a4450] hover:border-[#F59E0B] text-xs font-semibold whitespace-nowrap">Under ₹500</a>
        <a href="/categories/bluetooth-earbuds" class="px-3 py-1.5 rounded-lg bg-[#1A2E35] hover:bg-[#F59E0B] text-[#F4F1EA] transition-all border border-[#2a4450] hover:border-[#F59E0B] text-xs font-semibold whitespace-nowrap">Under ₹1000</a>
        <a href="/categories/power-banks" class="px-3 py-1.5 rounded-lg bg-[#1A2E35] hover:bg-[#F59E0B] text-[#F4F1EA] transition-all border border-[#2a4450] hover:border-[#F59E0B] text-xs font-semibold whitespace-nowrap">Under ₹1500</a>
        <a href="/categories/smartwatches" class="px-3 py-1.5 rounded-lg bg-[#1A2E35] hover:bg-[#F59E0B] text-[#F4F1EA] transition-all border border-[#2a4450] hover:border-[#F59E0B] text-xs font-semibold whitespace-nowrap">Under ₹2000</a>
      </div>
    </div>
  </section>

  <!-- Featured Deals with Countdown -->
  <section class="py-12 relative overflow-hidden">
    <div class="container">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-[#F4F1EA] mb-2">
            🔥 Featured Deals
          </h2>
          <p class="text-[#a8b5ba]">Limited time offers - Don't miss out!</p>
        </div>
        <a href="/reviews?sort=deals" class="hidden md:flex items-center gap-2 text-[#F59E0B] hover:text-[#d4834f] transition-colors">
          View All Deals
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {featuredDeals.map((deal) => (
          <a
            href={deal.href}
            class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#1A2E35] to-[#0F1F24] border border-[#2a4450]/50 hover:border-[#F59E0B]/50 transition-all duration-300 hover:shadow-glow-copper"
          >
            <div class="absolute inset-0 bg-gradient-to-r from-[#F59E0B]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6 flex items-center justify-between">
              <div>
                <span class="inline-block px-3 py-1 bg-[#F59E0B] text-white text-sm font-bold rounded-lg mb-3 animate-countdown-pulse">
                  {deal.discount}
                </span>
                <h3 class="text-xl font-bold text-[#F4F1EA] mb-2">{deal.title}</h3>
                <div class="countdown" data-end-time={deal.endTime.toISOString()}>
                  <span class="text-sm text-[#a8b5ba]">Ends in: </span>
                  <div class="inline-flex gap-1 mt-1">
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="hours">00</span>
                      <span class="countdown-label">Hrs</span>
                    </span>
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="minutes">00</span>
                      <span class="countdown-label">Min</span>
                    </span>
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="seconds">00</span>
                      <span class="countdown-label">Sec</span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="w-20 h-20 bg-[#F59E0B]/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <svg class="w-10 h-10 text-[#F59E0B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Categories -->
  <section class="py-16 relative">
    <div class="absolute inset-0 decorative-dots opacity-20"></div>
    <div class="container relative">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 bg-[#F59E0B]/10 text-[#F59E0B] text-sm font-semibold rounded-full mb-4">
          Browse Categories
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-4">
          Shop by Category
        </h2>
        <p class="text-[#a8b5ba] max-w-2xl mx-auto">
          Explore our curated collection of budget tech products across popular categories
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {categories.map((category, index) => (
          <a
            href={`/categories/${category.slug}`}
            class="group card-premium card-shine p-6 text-center scroll-animate"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="w-16 h-16 mx-auto mb-4 bg-[#F59E0B]/10 text-[#F59E0B] rounded-xl flex items-center justify-center group-hover:bg-[#F59E0B] group-hover:text-[#F4F1EA] transition-all duration-300 group-hover:scale-110">
              <Fragment set:html={categoryIcons[category.id] || `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`} />
            </div>
            <h3 class="font-semibold text-[#F4F1EA] mb-2 group-hover:text-[#F59E0B] transition-colors duration-200">
              {category.name}
            </h3>
            <p class="text-sm text-[#a8b5ba] line-clamp-2 mb-3">
              {category.description}
            </p>
            <span class="inline-flex items-center gap-1 text-xs text-[#F59E0B] font-medium">
              {category.productCount} products
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16 bg-[#0a1619]">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-12">
        <div>
          <span class="inline-block px-4 py-1.5 bg-[#F59E0B]/10 text-[#F59E0B] text-sm font-semibold rounded-full mb-4">
            Top Picks
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-2">
            Featured Products
          </h2>
          <p class="text-[#a8b5ba]">
            Hand-picked products offering the best value for money
          </p>
        </div>
        <a href="/categories" class="btn-ghost-premium">
          View All Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {featuredProducts.map((product, index) => (
          <div class="scroll-animate w-full" style={`animation-delay: ${index * 100}ms`}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 gradient-radial-glow"></div>
    <div class="container relative">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 bg-[#F59E0B]/10 text-[#F59E0B] text-sm font-semibold rounded-full mb-4">
          Testimonials
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-4">
          What Our Readers Say
        </h2>
        <p class="text-[#a8b5ba] max-w-2xl mx-auto">
          Join thousands of satisfied readers who found their perfect budget tech
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((testimonial, index) => (
          <div class="testimonial-card scroll-animate" style={`animation-delay: ${index * 150}ms`}>
            <div class="flex items-center gap-1 mb-4">
              {[...Array(testimonial.rating)].map(() => (
                <svg class="w-4 h-4 text-[#ffa41c]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-[#a8b5ba] mb-6 leading-relaxed">
              "{testimonial.text}"
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#F59E0B] to-[#d4834f] flex items-center justify-center text-[#F4F1EA] font-bold text-sm">
                {testimonial.avatar}
              </div>
              <div>
                <p class="font-semibold text-[#F4F1EA]">{testimonial.name}</p>
                <p class="text-xs text-[#6b7d83]">{testimonial.location}</p>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-[#2a4450]/30">
              <p class="text-xs text-[#6b7d83]">
                Purchased: <span class="text-[#F59E0B]">{testimonial.product}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand Logos Section with Float Animation -->
  <section class="py-12 bg-[#0a1619]/50">
    <div class="container">
      <h2 class="text-center text-[#a8b5ba] mb-8">Trusted Brands We Review</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-6">
