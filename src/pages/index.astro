---
/**
 * Home Page for BudgetTechIndia
 * Premium Dark Theme - Enhanced with testimonials, brand logos, featured deals
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProductCard from '../components/products/ProductCard.astro';
import JsonLD from '../components/seo/JsonLD.astro';
import type { Category, Product, Article } from '../utils/interfaces';

// Import sample data
import categoriesData from '../data/categories.json';
import productsData from '../data/products.json';
import articlesData from '../data/articles.json';

// Get featured categories
const categories: Category[] = categoriesData.categories;

// Get featured products (first 8)
const featuredProducts: Product[] = productsData.products.slice(0, 8);

// Get latest reviews
const latestReviews = articlesData.articles
  .filter((article) => article.type === 'review')
  .slice(0, 3);

// Get top 5 lists
const top5Lists = articlesData.articles
  .filter((article) => article.type === 'top5')
  .slice(0, 3);

// Testimonials data
const testimonials = [
  {
    name: 'Rahul Sharma',
    location: 'Mumbai',
    avatar: 'RS',
    rating: 5,
    text: 'Found the perfect earbuds under ₹1000 thanks to BudgetTechIndia. Their detailed reviews helped me make an informed decision without overspending.',
    product: 'Boat Airdopes 141',
  },
  {
    name: 'Priya Patel',
    location: 'Delhi',
    avatar: 'PP',
    rating: 5,
    text: 'The comparison tables are so helpful! I was confused between two smartwatches, and their side-by-side comparison made my choice easy.',
    product: 'Noise ColorFit Pro',
  },
  {
    name: 'Amit Kumar',
    location: 'Bangalore',
    avatar: 'AK',
    rating: 5,
    text: 'Finally, a website that understands budget constraints. Every recommendation is practical and value-for-money. Highly recommended!',
    product: 'Realme Power Bank',
  },
];

  // Brand logos with real-looking SVG designs
  const brands = [
    {
      name: 'Amazon',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="amazonGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#FF9900"/>
            <stop offset="100%" style="stop-color:#FF6600"/>
          </linearGradient>
        </defs>
        <!-- Amazon arrow smile -->
        <path d="M5 25 Q15 32 30 25" stroke="url(#amazonGrad)" stroke-width="3" fill="none" stroke-linecap="round"/>
        <!-- Arrow head -->
        <path d="M28 22 L32 26 L26 28" fill="url(#amazonGrad)"/>
        <!-- Text -->
        <text x="38" y="26" font-family="Arial, sans-serif" font-size="15" font-weight="700" fill="#FF9900">amazon</text>
      </svg>`
    },
    {
      name: 'Flipkart',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="flipkartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#2874F0"/>
            <stop offset="100%" style="stop-color:#1E5DC4"/>
          </linearGradient>
        </defs>
        <!-- Shopping bag icon -->
        <rect x="6" y="10" width="20" height="22" rx="3" fill="url(#flipkartGrad)"/>
        <path d="M10 10 Q10 4 16 4 Q22 4 22 10" stroke="white" stroke-width="2" fill="none"/>
        <!-- Small plus sign -->
        <text x="16" y="24" font-family="Arial, sans-serif" font-size="12" font-weight="700" fill="white" text-anchor="middle">+</text>
        <!-- Text -->
        <text x="32" y="26" font-family="Arial, sans-serif" font-size="14" font-weight="700" fill="#2874F0">Flipkart</text>
      </svg>`
    },
    {
      name: 'boAt',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="boatGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF4444"/>
            <stop offset="100%" style="stop-color:#CC0000"/>
          </linearGradient>
        </defs>
        <!-- Boat icon -->
        <path d="M8 28 Q12 20 20 22 L18 28 Z" fill="url(#boatGrad)"/>
        <path d="M14 18 L14 24 L22 24 Q20 18 14 18" fill="url(#boatGrad)"/>
        <!-- Wave -->
        <path d="M6 30 Q10 26 14 30 Q18 34 22 30" stroke="url(#boatGrad)" stroke-width="2" fill="none"/>
        <!-- Text -->
        <text x="28" y="27" font-family="Arial Black, sans-serif" font-size="16" font-weight="900" fill="#FF4444">boAt</text>
      </svg>`
    },
    {
      name: 'Noise',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="noiseGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#FFD700"/>
            <stop offset="100%" style="stop-color:#FFA500"/>
          </linearGradient>
        </defs>
        <!-- Sound wave bars -->
        <rect x="5" y="18" width="3" height="8" rx="1" fill="url(#noiseGrad)"/>
        <rect x="10" y="14" width="3" height="16" rx="1" fill="url(#noiseGrad)"/>
        <rect x="15" y="10" width="3" height="24" rx="1" fill="url(#noiseGrad)"/>
        <rect x="20" y="14" width="3" height="16" rx="1" fill="url(#noiseGrad)"/>
        <rect x="25" y="18" width="3" height="8" rx="1" fill="url(#noiseGrad)"/>
        <!-- Text -->
        <text x="35" y="27" font-family="Arial, sans-serif" font-size="16" font-weight="700" fill="#FFD700">Noise</text>
      </svg>`
    },
    {
      name: 'realme',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="realmeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#00D4AA"/>
            <stop offset="100%" style="stop-color:#00A085"/>
          </linearGradient>
        </defs>
        <!-- Stylized R icon -->
        <circle cx="15" cy="20" r="12" stroke="url(#realmeGrad)" stroke-width="2" fill="none"/>
        <path d="M10 15 L10 28 M10 15 Q10 20 15 20 L20 28" stroke="url(#realmeGrad)" stroke-width="2" fill="none" stroke-linecap="round"/>
        <!-- Text -->
        <text x="32" y="26" font-family="Arial, sans-serif" font-size="14" font-weight="600" fill="#00D4AA">realme</text>
      </svg>`
    },
    {
      name: 'Redmi',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="redmiGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF6700"/>
            <stop offset="100%" style="stop-color:#E55A00"/>
          </linearGradient>
        </defs>
        <!-- Xiaomi-style rounded square -->
        <rect x="4" y="8" width="24" height="24" rx="4" fill="url(#redmiGrad)"/>
        <text x="16" y="25" font-family="Arial, sans-serif" font-size="12" font-weight="700" fill="white" text-anchor="middle">R</text>
        <!-- Text -->
        <text x="35" y="26" font-family="Arial, sans-serif" font-size="15" font-weight="700" fill="#FF6700">Redmi</text>
      </svg>`
    },
    {
      name: 'OnePlus',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="oneplusGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#EB0029"/>
            <stop offset="100%" style="stop-color:#C00020"/>
          </linearGradient>
        </defs>
        <!-- OnePlus box logo -->
        <rect x="4" y="6" width="28" height="28" rx="3" stroke="url(#oneplusGrad)" stroke-width="2" fill="none"/>
        <!-- 1+ inside -->
        <text x="10" y="26" font-family="Arial, sans-serif" font-size="18" font-weight="700" fill="#EB0029">1</text>
        <text x="18" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="700" fill="#EB0029">+</text>
        <!-- Text -->
        <text x="38" y="26" font-family="Arial, sans-serif" font-size="13" font-weight="600" fill="#EB0029">OnePlus</text>
      </svg>`
    },
    {
      name: 'Ambrane',
      svg: `<svg viewBox="0 0 120 40" class="w-full h-full">
        <defs>
          <linearGradient id="ambraneGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#00A3E0"/>
            <stop offset="100%" style="stop-color:#0077B5"/>
          </linearGradient>
        </defs>
        <!-- Power/battery icon -->
        <rect x="4" y="12" width="22" height="16" rx="2" stroke="url(#ambraneGrad)" stroke-width="2" fill="none"/>
        <rect x="26" y="16" width="3" height="8" rx="1" fill="url(#ambraneGrad)"/>
        <!-- Lightning bolt inside -->
        <path d="M14 14 L11 22 L15 22 L13 28 L19 20 L15 20 L17 14 Z" fill="url(#ambraneGrad)"/>
        <!-- Text -->
        <text x="35" y="26" font-family="Arial, sans-serif" font-size="13" font-weight="600" fill="#00A3E0">Ambrane</text>
      </svg>`
    },
  ];

// Featured deals with countdown
const featuredDeals = [
  {
    title: 'Flash Sale: Earbuds',
    discount: 'Up to 70% OFF',
    endTime: new Date(Date.now() + 24 * 60 * 60 * 1000), // 24 hours from now
    href: '/categories/bluetooth-earbuds',
    image: '/images/categories/earbuds.jpg',
  },
  {
    title: 'Smartwatch Deals',
    discount: 'Starting ₹999',
    endTime: new Date(Date.now() + 12 * 60 * 60 * 1000), // 12 hours from now
    href: '/categories/smartwatches',
    image: '/images/categories/smartwatches.jpg',
  },
];

// Category icons mapping
const categoryIcons: Record<string, string> = {
  'bluetooth-earbuds': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3" /></svg>`,
  'power-banks': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  'fast-chargers-cables': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  'smartwatches': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  'laptop-accessories': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  'budget-gadgets-under-999': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>`,
  'work-from-home-essentials': `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>`,
};

// Website schema for SEO
const websiteSchema = {
  name: 'BudgetTechIndia',
  url: 'https://budgettechindia.com',
  description: 'Your trusted source for honest tech product reviews under ₹2,000 in India.',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://budgettechindia.com/search?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="BudgetTechIndia - Best Budget Tech Products Under ₹2,000"
  description="Discover the best budget tech products under ₹2,000 in India. Honest reviews, top 5 lists, and buying guides for earbuds, smartwatches, power banks, and more."
  currentPath="/"
>
  <!-- Hero Section -->
  <Hero />

  <!-- Featured Deals with Countdown -->
  <section class="py-12 relative overflow-hidden">
    <div class="container">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-[#F4F1EA] mb-2">
            🔥 Featured Deals
          </h2>
          <p class="text-[#a8b5ba]">Limited time offers - Don't miss out!</p>
        </div>
        <a href="/reviews?sort=deals" class="hidden md:flex items-center gap-2 text-[#C46A3A] hover:text-[#d4834f] transition-colors">
          View All Deals
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {featuredDeals.map((deal) => (
          <a
            href={deal.href}
            class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#1A2E35] to-[#0F1F24] border border-[#2a4450]/50 hover:border-[#C46A3A]/50 transition-all duration-300 hover:shadow-glow-copper"
          >
            <div class="absolute inset-0 bg-gradient-to-r from-[#C46A3A]/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <div class="relative p-6 flex items-center justify-between">
              <div>
                <span class="inline-block px-3 py-1 bg-[#C46A3A] text-white text-sm font-bold rounded-lg mb-3 animate-countdown-pulse">
                  {deal.discount}
                </span>
                <h3 class="text-xl font-bold text-[#F4F1EA] mb-2">{deal.title}</h3>
                <div class="countdown" data-end-time={deal.endTime.toISOString()}>
                  <span class="text-sm text-[#a8b5ba]">Ends in: </span>
                  <div class="inline-flex gap-1 mt-1">
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="hours">00</span>
                      <span class="countdown-label">Hrs</span>
                    </span>
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="minutes">00</span>
                      <span class="countdown-label">Min</span>
                    </span>
                    <span class="countdown-item">
                      <span class="countdown-value" data-unit="seconds">00</span>
                      <span class="countdown-label">Sec</span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="w-20 h-20 bg-[#C46A3A]/20 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <svg class="w-10 h-10 text-[#C46A3A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Categories -->
  <section class="py-16 relative">
    <div class="absolute inset-0 decorative-dots opacity-20"></div>
    <div class="container relative">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 bg-[#C46A3A]/10 text-[#C46A3A] text-sm font-semibold rounded-full mb-4">
          Browse Categories
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-4">
          Shop by Category
        </h2>
        <p class="text-[#a8b5ba] max-w-2xl mx-auto">
          Explore our curated collection of budget tech products across popular categories
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {categories.map((category, index) => (
          <a
            href={`/categories/${category.slug}`}
            class="group card-premium p-6 text-center scroll-animate"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="w-16 h-16 mx-auto mb-4 bg-[#C46A3A]/10 text-[#C46A3A] rounded-xl flex items-center justify-center group-hover:bg-[#C46A3A] group-hover:text-[#F4F1EA] transition-all duration-300 group-hover:scale-110">
              <Fragment set:html={categoryIcons[category.id] || `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>`} />
            </div>
            <h3 class="font-semibold text-[#F4F1EA] mb-2 group-hover:text-[#C46A3A] transition-colors duration-200">
              {category.name}
            </h3>
            <p class="text-sm text-[#a8b5ba] line-clamp-2 mb-3">
              {category.description}
            </p>
            <span class="inline-flex items-center gap-1 text-xs text-[#C46A3A] font-medium">
              {category.productCount} products
              <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Products -->
  <section class="py-16 bg-[#0a1619]">
    <div class="container">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-12">
        <div>
          <span class="inline-block px-4 py-1.5 bg-[#C46A3A]/10 text-[#C46A3A] text-sm font-semibold rounded-full mb-4">
            Top Picks
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-2">
            Featured Products
          </h2>
          <p class="text-[#a8b5ba]">
            Hand-picked products offering the best value for money
          </p>
        </div>
        <a href="/categories" class="btn-ghost-premium">
          View All Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product, index) => (
          <div class="scroll-animate" style={`animation-delay: ${index * 100}ms`}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-16 relative overflow-hidden">
    <div class="absolute inset-0 gradient-radial-glow"></div>
    <div class="container relative">
      <div class="text-center mb-12">
        <span class="inline-block px-4 py-1.5 bg-[#C46A3A]/10 text-[#C46A3A] text-sm font-semibold rounded-full mb-4">
          Testimonials
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-[#F4F1EA] mb-4">
          What Our Readers Say
        </h2>
        <p class="text-[#a8b5ba] max-w-2xl mx-auto">
          Join thousands of satisfied readers who found their perfect budget tech
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {testimonials.map((testimonial, index) => (
          <div class="testimonial-card scroll-animate" style={`animation-delay: ${index * 150}ms`}>
            <div class="flex items-center gap-1 mb-4">
              {[...Array(testimonial.rating)].map(() => (
                <svg class="w-4 h-4 text-[#ffa41c]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-[#a8b5ba] mb-6 leading-relaxed">
              "{testimonial.text}"
            </p>
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#C46A3A] to-[#d4834f] flex items-center justify-center text-[#F4F1EA] font-bold text-sm">
                {testimonial.avatar}
              </div>
              <div>
                <p class="font-semibold text-[#F4F1EA]">{testimonial.name}</p>
                <p class="text-xs text-[#6b7d83]">{testimonial.location}</p>
              </div>
            </div>
            <div class="mt-4 pt-4 border-t border-[#2a4450]/30">
              <p class="text-xs text-[#6b7d83]">
                Purchased: <span class="text-[#C46A3A]">{testimonial.product}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand Logos Section with Float Animation -->
  <section class="py-12 bg-[#0a1619]/50">
    <div class="container">
      <h2 class="text-center text-[#a8b5ba] mb-8">Trusted Brands We Review</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-6">
        {brands.map((brand, index) => (
          <div 
            class="brand-logo-float relative flex items-center justify-center p-6 bg-[#0F1F24] rounded-xl hover:bg-[#1A2E35] transition-all duration-300 border border-[#2a4450]/30 hover:border-[#C46A3A]/40 group"
            style={`animation-delay: ${index * 0.5}s`}
          >
            <div class="w-24 h-10 transition-transform duration-300 group-hover:scale-110">
              <Fragment set:html={brand.svg} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Reviews -->
