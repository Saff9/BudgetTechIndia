---
/**
 * Terms & Conditions Page for BudgetTechIndia
 * Legal terms governing use of the website
 */

import LegalLayout from '../layouts/LegalLayout.astro';
import type { BreadcrumbItem } from '../utils/interfaces';
import SEO from '../components/seo/SEO.astro';
import JsonLD from '../components/seo/JsonLD.astro';

const breadcrumbs: BreadcrumbItem[] = [
  { name: 'Home', url: '/' },
  { name: 'Terms & Conditions' },
];

const lastUpdated = new Date('2026-02-15');
---

<LegalLayout
  title="Terms & Conditions"
  description="Terms and conditions governing your use of BudgetTechIndia. Please read these terms carefully before using our website."
  lastUpdated={lastUpdated}
  breadcrumbs={breadcrumbs}
  currentPath="/terms-conditions"
