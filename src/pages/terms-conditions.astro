    <li><strong>Contact Form:</strong> <a href="/contact">Contact Page</a></li>
  </ul>

  <div class="bg-neutral-100 rounded-lg p-6 mt-8">
    <h3 class="text-lg font-semibold text-neutral-900 mb-2">Acknowledgment</h3>
