    type="article"
    data={{
      article: {
        title: "Terms & Conditions",
        description: "Terms and conditions governing your use of BudgetTechIndia.",
        pubDate: "2026-02-15"
      },
      url: "https://budgettechindia.com/terms-conditions",
      imageUrl: "https://placehold.co/1200x630/0F1F24/F4F1EA?text=Terms+%26+Conditions",
      authorName: "BudgetTechIndia"
    }}
