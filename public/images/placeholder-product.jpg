  <rect width="600" height="600" fill="url(#bg)"/>
  <circle cx="300" cy="270" r="140" fill="#FFB800" fill-opacity="0.08"/>
  <rect x="180" y="150" width="240" height="240" rx="30" fill="none" stroke="url(#gold)" stroke-width="4"/>
  <path d="M270 240l60 30-60 30v-60z" fill="url(#gold)"/>
