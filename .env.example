# BudgetTechIndia Environment Variables
# =====================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]

# ========================================
# Site Configuration [REQUIRED]
# ========================================
SITE_URL=https://budgettechindia.com
SITE_NAME=BudgetTechIndia
SITE_DESCRIPTION=India's trusted source for budget tech reviews, comparisons, and deals
SITE_LOCALE=en_IN
SITE_CURRENCY=INR

# ========================================
# Affiliate Configuration [REQUIRED]
# ========================================
# Amazon Associates India Affiliate Tag
AMAZON_AFFILIATE_TAG=budgettechin-21

# Flipkart Affiliate ID (optional)
FLIPKART_AFFILIATE_ID=budgettech

# Default affiliate store (amazon or flipkart)
DEFAULT_AFFILIATE_STORE=amazon

# ========================================
# Analytics Configuration (Optional)
# ========================================
# Google Analytics 4
GOOGLE_ANALYTICS_ID=
# Example: G-XXXXXXXXXX

# Google Tag Manager
GOOGLE_TAG_MANAGER_ID=
# Example: GTM-XXXXXXX

# Plausible Analytics (privacy-friendly alternative)
PLAUSIBLE_DOMAIN=
# Example: budgettechindia.com

# ========================================
# Social Media Links (Optional)
# ========================================
TWITTER_HANDLE=@budgettechindia
FACEBOOK_PAGE=budgettechindia
INSTAGRAM_HANDLE=@budgettechindia
YOUTUBE_CHANNEL=
TELEGRAM_CHANNEL=

# ========================================
# Contact Information
# ========================================
CONTACT_EMAIL=contact@budgettechindia.com
SUPPORT_EMAIL=support@budgettechindia.com

# ========================================
# Feature Flags
# ========================================
# Enable/disable analytics tracking
ENABLE_ANALYTICS=false

# Enable/disable comments system
ENABLE_COMMENTS=false

# Enable/disable newsletter signup
ENABLE_NEWSLETTER=true

# Enable/disable affiliate click tracking
ENABLE_AFFILIATE_TRACKING=true

# Enable/disable search functionality
ENABLE_SEARCH=true

# ========================================
# Performance & Caching
# ========================================
# Cache TTL for static assets (in seconds)
CACHE_TTL=86400

# Enable CDN for static assets
USE_CDN=false
CDN_URL=

# ========================================
# Security
# ========================================
# Content Security Policy (CSP)
ENABLE_CSP=true

# HSTS (HTTP Strict Transport Security)
ENABLE_HSTS=true

# ========================================
# Development Settings
# ========================================
# Enable debug mode (shows more detailed errors)
DEBUG_MODE=false

# Enable development tools in production
ENABLE_DEV_TOOLS=false

# ========================================
# SEO Settings
# ========================================
# Default Open Graph image
OG_DEFAULT_IMAGE=/images/og/default.jpg

# Twitter card type
TWITTER_CARD_TYPE=summary_large_image

# ========================================
# Third-party API Keys (Optional)
# ========================================
# For price tracking APIs
PRICE_API_KEY=

# For product data enrichment
PRODUCT_API_KEY=

# ========================================
# Deployment Configuration
# ========================================
# Deployment platform (vercel, netlify, render, etc.)
DEPLOYMENT_PLATFORM=

# Environment (development, staging, production)
NODE_ENV=production

# ========================================
# Rate Limiting
# ========================================
# API rate limit (requests per minute)
RATE_LIMIT_API=60

# Search rate limit (requests per minute)
RATE_LIMIT_SEARCH=30
